. /lib/functions/leds.sh
. /lib/functions/uci-defaults.sh

board=$(board_name)

board_config_update

case $board in
vsol,hg325ax30)
	ucidef_set_led_netdev "lan1" "LAN1" "green:lan-1" "lan1" "link tx rx"
	ucidef_set_led_netdev "lan2" "LAN2" "green:lan-2" "lan2" "link tx rx"
	ucidef_set_led_netdev "lan3" "LAN3" "green:lan-3" "lan3" "link tx rx"
	ucidef_set_led_netdev "lan4" "LAN4" "4f4300000.ethernet:07:green:lan-4" "lan4" "link tx rx"
	ucidef_set_led_netdev "wlan5g" "WLAN5G" "rtw89-0000:01:00.0" "wl1-ap0" "link tx rx"
	ucidef_set_led_usbport "usb" "USB" "green:usb" "usb1-port1" "usb1-port2" "usb2-port1"
	;;
esac

board_config_flush

exit 0
