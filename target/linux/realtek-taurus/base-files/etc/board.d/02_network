. /lib/functions/uci-defaults.sh
. /lib/functions/system.sh

realtek_taurus_setup_interfaces()
{
	local board="$1"

	case "$board" in
	vsol,hg325ax30)
		ucidef_set_interfaces_lan_wan "lan1 lan2 lan3 lan4" "pon0"
		ucidef_add_wlan "soc/f4326000.pcie/pci0001:00/0001:00:00.0/0001:01:00.0"
		ucidef_add_wlan "soc/f4325000.pcie/pci0000:00/0000:00:00.0/0000:01:00.0"
		ucidef_set_country "US"
		ucidef_set_wireless_mac_count 2g 2
		ucidef_set_wireless_mac_count 5g 2
		;;
	*)
		echo "Unsupported hardware. Network interfaces not initialized"
		;;
	esac
}

board_config_update
board=$(board_name)
realtek_taurus_setup_interfaces $board
board_config_flush

exit 0
