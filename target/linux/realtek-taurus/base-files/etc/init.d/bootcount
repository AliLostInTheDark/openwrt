#!/bin/sh /etc/rc.common

START=99

boot() {
	case "$(board_name)" in
	vsol,hg325ax30)
		# sysupgrade set upgrade_available and U-Boot counted the boots
		# of the new image since; this one got far enough to be good.
		[ -e /etc/fw_env.config ] || return 0
		[ "$(fw_printenv -n upgrade_available 2>/dev/null)" = 1 ] || return 0
		printf 'bootcount 0\nupgrade_available 0\n' | fw_setenv -s -
		;;
	esac
}
