From: Ifran Ali <khanu.i.i.k.2000@gmail.com>
Subject: [PATCH] watchdog: add the Realtek RTL9607DQ watchdog driver to the build

Add the Kconfig entry and Makefile line of the watchdog driver of the
Realtek RTL9607DQ (Cortina Access) SoC.

Signed-off-by: Ifran Ali <khanu.i.i.k.2000@gmail.com>
---
--- a/drivers/watchdog/Kconfig
+++ b/drivers/watchdog/Kconfig
@@ -1076,6 +1076,17 @@
 
 	  When built as a module this will be called realtek_otto_wdt.
 
+config RTL9607DQ_WATCHDOG
+	tristate "Realtek RTL9607DQ watchdog support"
+	depends on OF && HAS_IOMEM
+	depends on COMMON_CLK
+	select WATCHDOG_CORE
+	help
+	  Say Y here to include support for the watchdog timer of the
+	  Realtek RTL9607DQ (Cortina Access) GPON SoC.
+
+	  When built as a module this will be called rtl9607dq_wdt.
+
 config SPRD_WATCHDOG
 	tristate "Spreadtrum watchdog support"
 	depends on ARCH_SPRD || COMPILE_TEST
--- a/drivers/watchdog/Makefile
+++ b/drivers/watchdog/Makefile
@@ -185,6 +185,7 @@
 obj-$(CONFIG_PIC32_WDT) += pic32-wdt.o
 obj-$(CONFIG_PIC32_DMT) += pic32-dmt.o
 obj-$(CONFIG_REALTEK_OTTO_WDT) += realtek_otto_wdt.o
+obj-$(CONFIG_RTL9607DQ_WATCHDOG) += rtl9607dq_wdt.o
 
 # PARISC Architecture
 
