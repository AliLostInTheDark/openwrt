From: Ifran Ali <khanu.i.i.k.2000@gmail.com>
Subject: [PATCH] spi: add the RTL9607DQ peripheral SPI driver to the build

Add the Kconfig entry and Makefile line of the peripheral SPI controller
of the Realtek RTL9607DQ, which carries the SLIC on the HG325AX30.

Signed-off-by: Ifran Ali <khanu.i.i.k.2000@gmail.com>
---
Index: linux-6.18.60/drivers/spi/Kconfig
===================================================================
--- linux-6.18.60.orig/drivers/spi/Kconfig
+++ linux-6.18.60/drivers/spi/Kconfig
@@ -952,6 +952,14 @@
 	help
 	  SPI driver for Renesas RSPI and QSPI blocks.
 
+config SPI_RTL9607DQ_PER
+	tristate "Realtek RTL9607DQ peripheral SPI controller"
+	depends on OF && HAS_IOMEM
+	help
+	  This enables support for the peripheral SPI controller of the
+	  Realtek RTL9607DQ SoC, used for SLICs and other low-rate devices.
+	  It is not the flash controller.
+
 config SPI_RZV2H_RSPI
 	tristate "Renesas RZ/V2H RSPI controller"
 	depends on ARCH_RENESAS || COMPILE_TEST
Index: linux-6.18.60/drivers/spi/Makefile
===================================================================
--- linux-6.18.60.orig/drivers/spi/Makefile
+++ linux-6.18.60/drivers/spi/Makefile
@@ -129,6 +129,7 @@
 obj-$(CONFIG_SPI_REALTEK_SNAND)		+= spi-realtek-rtl-snand.o
 obj-$(CONFIG_SPI_RPCIF)			+= spi-rpc-if.o
 obj-$(CONFIG_SPI_RSPI)			+= spi-rspi.o
+obj-$(CONFIG_SPI_RTL9607DQ_PER)		+= spi-rtl9607dq-per.o
 obj-$(CONFIG_SPI_RZV2H_RSPI)		+= spi-rzv2h-rspi.o
 obj-$(CONFIG_SPI_RZV2M_CSI)		+= spi-rzv2m-csi.o
 obj-$(CONFIG_SPI_S3C64XX)		+= spi-s3c64xx.o
