From: Ifran Ali <khanu.i.i.k.2000@gmail.com>
Subject: [PATCH] spi: add the Cortina Access QSPI driver to the build

Add the Kconfig entry and Makefile line of the QSPI flash controller
driver of Cortina Access and Realtek RTL9607DQ SoCs.

Signed-off-by: Ifran Ali <khanu.i.i.k.2000@gmail.com>
---
Index: linux-6.18.60/drivers/spi/Kconfig
===================================================================
--- linux-6.18.60.orig/drivers/spi/Kconfig
+++ linux-6.18.60/drivers/spi/Kconfig
@@ -331,6 +331,14 @@ config SPI_COLDFIRE_QSPI
 	  This enables support for the Coldfire QSPI controller in master
 	  mode.
 
+config SPI_CORTINA_QSPI
+	tristate "Cortina Access QSPI controller"
+	depends on OF && HAS_IOMEM
+	depends on SPI_MEM
+	help
+	  This enables support for the QSPI flash controller of Cortina
+	  Access and Realtek RTL9607DQ SoCs.
+
 config SPI_CS42L43
 	tristate "Cirrus Logic CS42L43 SPI controller"
 	depends on MFD_CS42L43 && PINCTRL_CS42L43
Index: linux-6.18.60/drivers/spi/Makefile
===================================================================
--- linux-6.18.60.orig/drivers/spi/Makefile
+++ linux-6.18.60/drivers/spi/Makefile
@@ -46,6 +46,7 @@ obj-$(CONFIG_SPI_CADENCE_XSPI)		+= spi-c
 obj-$(CONFIG_SPI_CH341)			+= spi-ch341.o
 obj-$(CONFIG_SPI_CLPS711X)		+= spi-clps711x.o
 obj-$(CONFIG_SPI_COLDFIRE_QSPI)		+= spi-coldfire-qspi.o
+obj-$(CONFIG_SPI_CORTINA_QSPI)		+= spi-cortina-qspi.o
 obj-$(CONFIG_SPI_CS42L43)		+= spi-cs42l43.o
 obj-$(CONFIG_SPI_DAVINCI)		+= spi-davinci.o
 obj-$(CONFIG_SPI_DLN2)			+= spi-dln2.o
