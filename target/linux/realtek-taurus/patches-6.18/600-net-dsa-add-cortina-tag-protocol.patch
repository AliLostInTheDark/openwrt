From: Ifran Ali <khanu.i.i.k.2000@gmail.com>
Subject: [PATCH] net: dsa: add a tag driver for the Realtek RTL9607DQ network engine

The network engine of the Realtek RTL9607DQ is both the DSA conduit and
the switch.  The port of a frame is carried in the DMA descriptors
rather than on the wire, so the tagger only passes it between the
Ethernet driver and the DSA core.  Add its protocol number and build
hooks.

Signed-off-by: Ifran Ali <khanu.i.i.k.2000@gmail.com>
---
Index: linux-6.18.60/include/net/dsa.h
===================================================================
--- linux-6.18.60.orig/include/net/dsa.h
+++ linux-6.18.60/include/net/dsa.h
@@ -60,6 +60,7 @@ struct tc_action;
 #define DSA_TAG_PROTO_YT921X_VALUE		32
 #define DSA_TAG_PROTO_YT922X_VALUE		33
 #define DSA_TAG_PROTO_YT922X_4B_VALUE		34
+#define DSA_TAG_PROTO_CORTINA_VALUE		35
 
 enum dsa_tag_protocol {
 	DSA_TAG_PROTO_NONE		= DSA_TAG_PROTO_NONE_VALUE,
@@ -97,6 +98,7 @@ enum dsa_tag_protocol {
 	DSA_TAG_PROTO_YT921X		= DSA_TAG_PROTO_YT921X_VALUE,
 	DSA_TAG_PROTO_YT922X		= DSA_TAG_PROTO_YT922X_VALUE,
 	DSA_TAG_PROTO_YT922X_4B		= DSA_TAG_PROTO_YT922X_4B_VALUE,
+	DSA_TAG_PROTO_CORTINA		= DSA_TAG_PROTO_CORTINA_VALUE,
 };
 
 struct dsa_switch;
Index: linux-6.18.60/net/dsa/Kconfig
===================================================================
--- linux-6.18.60.orig/net/dsa/Kconfig
+++ linux-6.18.60/net/dsa/Kconfig
@@ -69,6 +69,13 @@ config NET_DSA_TAG_BRCM_PREPEND
 	  Broadcom switches which places the tag before the Ethernet header
 	  (prepended).
 
+config NET_DSA_TAG_CORTINA
+	tristate "Tag driver for the Realtek RTL9607DQ network engine"
+	help
+	  Say Y or M if you want to enable support for tagging frames for the
+	  network engine of the Realtek RTL9607DQ (Cortina Access) SoC.  The
+	  port is carried in the DMA descriptors, not on the wire.
+
 config NET_DSA_TAG_HELLCREEK
 	tristate "Tag driver for Hirschmann Hellcreek TSN switches"
 	help
Index: linux-6.18.60/net/dsa/Makefile
===================================================================
--- linux-6.18.60.orig/net/dsa/Makefile
+++ linux-6.18.60/net/dsa/Makefile
@@ -22,6 +22,7 @@ dsa_core-y += \
 # tagging formats
 obj-$(CONFIG_NET_DSA_TAG_AR9331) += tag_ar9331.o
 obj-$(CONFIG_NET_DSA_TAG_BRCM_COMMON) += tag_brcm.o
+obj-$(CONFIG_NET_DSA_TAG_CORTINA) += tag_cortina.o
 obj-$(CONFIG_NET_DSA_TAG_DSA_COMMON) += tag_dsa.o
 obj-$(CONFIG_NET_DSA_TAG_GSWIP) += tag_gswip.o
 obj-$(CONFIG_NET_DSA_TAG_HELLCREEK) += tag_hellcreek.o
