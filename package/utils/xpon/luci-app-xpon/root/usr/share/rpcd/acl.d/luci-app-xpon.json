{
	"luci-app-xpon": {
		"description": "Grant access to unified xPON (GPON OMCI, EPON OAM, PON Mode, diagnostics)",
		"read": {
			"ubus": {
				"xpon.public": [
					"status"
				],
				"xpon.agent": [
					"status",
					"epon_status"
				],
				"omci.agent": [
					"family",
					"status",
					"config_list",
					"config_details",
					"config_get",
					"config_inspect",
					"class_list",
					"class_get",
					"mib_list",
					"mib_get",
					"status_live",
					"events"
				],
				"omci.vlan": [
					"status"
				]
			},
			"file": {
				"/var/run/epon-oamd.json": [
					"read"
				],
				"/tmp/run/epon-oamd.json": [
					"read"
				],
				"/sys/class/net/pon0/device/epon_state": [
					"read"
				],
				"/sys/devices/platform/soc/*.pon/epon_state": [
					"read"
				],
				"/sys/class/net/pon0/device/bosa_ddm": [
					"read"
				],
				"/sys/devices/platform/soc/*.pon/bosa_ddm": [
					"read"
				],
				"/sys/class/net/pon0/device/allow_tx": [
					"read"
				],
				"/sys/devices/platform/soc/*.pon/allow_tx": [
					"read"
				],
				"/sys/class/net/pon0/device/tx_hold": [
					"read"
				],
				"/sys/devices/platform/soc/*.pon/tx_hold": [
					"read"
				],
				"/etc/xpon-rogue": [
					"read"
				]
			},
			"uci": [
				"xpon",
				"omci",
				"epon",
				"network"
			]
		},
		"write": {
			"ubus": {
				"xpon.agent": [
					"set_mode",
					"epon_tx_release"
				],
				"omci.agent": [
					"agent_set",
					"config_set",
					"mib_set",
					"mib_delete",
					"mib_reset",
					"apply",
					"re_register"
				],
				"uci": [
					"commit"
				],
				"system": [
					"reboot"
				],
				"file": [
					"remove",
					"stat"
				]
			},
			"uci": [
				"xpon",
				"omci",
				"epon",
				"network"
			],
			"file": {
				"/usr/sbin/xpon-report -o -": [
					"exec"
				],
				"/usr/sbin/omci-vlanscan *": [
					"exec"
				],
				"/sys/class/net/pon0/device/tx_hold": [
					"write"
				],
				"/sys/devices/platform/soc/*.pon/tx_hold": [
					"write"
				],
				"/etc/xpon-rogue": [
					"write"
				]
			}
		}
	}
}
