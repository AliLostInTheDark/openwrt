#!/bin/sh /etc/rc.common
# SPDX-License-Identifier: GPL-2.0-only

START=99
USE_PROCD=1

start_service() {
	local enabled cr stun iface port zone

	config_load cwmp
	config_get_bool enabled main enabled 0
	[ "$enabled" = 1 ] || return 0
	config_get_bool cr main connection_request 0
	config_get_bool stun main stun_enable 0
	config_get iface main interface wan
	config_get port main connection_request_port 7547

	procd_open_instance
	procd_set_param command /usr/sbin/cwmpd
	procd_set_param file /etc/config/cwmp
	procd_set_param respawn

	# The ACS calls in on the interface's firewall zone only, and only
	# while connection requests or STUN are enabled.
	if [ "$cr" = 1 ] || [ "$stun" = 1 ]; then
		zone="$(fw4 -q network "$iface" 2>/dev/null)"
		procd_open_data
		json_add_array firewall
		if [ "$cr" = 1 ]; then
			json_add_object ""
			json_add_string type rule
			json_add_string name "Allow-CWMP-Connection-Request"
			json_add_string src "${zone:-wan}"
			json_add_string proto tcp
			json_add_string dest_port "$port"
			json_add_string target ACCEPT
			json_close_object
		fi
		if [ "$stun" = 1 ]; then
			json_add_object ""
			json_add_string type rule
			json_add_string name "Allow-CWMP-STUN"
			json_add_string src "${zone:-wan}"
			json_add_string proto udp
			json_add_string dest_port "$port"
			json_add_string target ACCEPT
			json_close_object
		fi
		json_close_array
		procd_close_data
	fi
	procd_close_instance
}

service_triggers() {
	procd_add_reload_trigger cwmp
}
