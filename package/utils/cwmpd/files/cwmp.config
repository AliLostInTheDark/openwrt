config cwmp 'main'
	option enabled '0'
	# ACS URL, http:// or https://; empty uses the one the OLT provisions over OMCI
	option url ''
	option username ''
	option password ''
	option omci_acs '1'
	# data model: tr181 (Device.) or tr098 (InternetGatewayDevice.)
	option data_model 'tr181'
	# netifd interface the ACS is reached through, e.g. wan or a management VLAN
	option interface 'wan'
	# any (dual stack), ipv4 or ipv6
	option family 'any'
	option verify_cert '1'
	option periodic_inform '1'
	option periodic_interval '86400'
	# sessions kept in /tmp/cwmp
	option log_sessions '20'
	# fetch what the ACS asks to download into /tmp/cwmp/downloads; never applied
	option capture_downloads '1'
	option download_max_kib '32768'
	# seconds a pretend reboot or factory reset takes before the next Inform
	option mock_reboot_delay '60'
	# let the ACS start a session; opens the port on the interface's zone
	option connection_request '0'
	option connection_request_port '7547'
	option connection_request_path '/'
	option connection_request_username ''
	option connection_request_password ''
	# optional TR-069 Annex G (TR-111) STUN NAT traversal & UDP connection requests
	option stun_enable '0'
	option stun_server ''
	option stun_port '3478'
	option stun_username ''
	option stun_password ''
	option stun_min_keepalive '30'
	option stun_max_keepalive '120'
	# save ACS SetParameterValues/DeleteObject state in /etc/cwmp/shadow.tsv across restarts
	option persist_shadow '0'

config device 'device'
	# reported in the Inform; empty values are filled from the board on first boot
	option manufacturer ''
	option oui ''
	option product_class ''
	option serial ''
	option hardware_version ''
	option software_version ''
	option provisioning_code ''
