/* SPDX-License-Identifier: GPL-2.0-or-later */
/*
 * Default environment of the VSOL HG325AX30
 *
 * OpenWrt is a FIT in ubi_k0, the kernel finds its own rootfs. After
 * bootlimit failed boots (bootcount in the environment) U-Boot runs
 * altbootcmd, which only stops at the prompt: the network is up there for a
 * TFTP recovery. "setenv bootcount 0; saveenv" retries the normal boot.
 *
 * bootfile_uboot is the whole fip0 slot (BL2, BL31 and this U-Boot as BL33).
 * The standby FIP in fip1 is never written by these scripts.
 *
 * Copyright (C) 2026 Ifran Ali <khanu.i.i.k.2000@gmail.com>
 */

ipaddr=192.168.1.1
serverip=192.168.1.100
loadaddr=0x5000000
bootfile_uboot=hg325ax30-fip0.bin

/* run stops at the first command that fails. */
bootcmd=run boot_a
boot_a=run prep load_kernel wdt_arm boot_kernel
upgrade_uboot=run load_uboot check_fip_size check_fip_magic write_uboot verify_uboot

prep=ubi part ubi_device
load_kernel=ubi read ${loadaddr} ubi_k0 0x600000
wdt_arm=wdt dev watchdog@f432901c; wdt start 60000
boot_kernel=bootm ${loadaddr}

/* bootcount only counts and saves while upgrade_available is set. */
upgrade_available=1
bootlimit=3
altbootcmd=echo Boot limit exceeded, staying at the prompt

/* A FIP starts with the magic 0xaa640001 and fills its 0xc0000 slot. */
load_uboot=tftpboot ${loadaddr} ${bootfile_uboot}
check_fip_size=itest ${filesize} == 0xc0000
check_fip_magic=itest.l *${loadaddr} == 0xaa640001
write_uboot=mtd erase fip0; mtd write fip0 ${loadaddr}
verify_uboot=mtd read fip0 0x5800000; cmp.b ${loadaddr} 0x5800000 0xc0000
