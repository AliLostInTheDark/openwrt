diff --git a/drivers/spi/Kconfig b/drivers/spi/Kconfig
index 007ad5e7..f5592f15 100644
--- a/drivers/spi/Kconfig
+++ b/drivers/spi/Kconfig
@@ -160,6 +160,14 @@ config CORTINA_SFLASH
 	  can be used to access the SPI NOR/NAND flash on platforms embedding this
 	  Cortina-Access IP core.
 
+config CORTINA_QSPI
+	bool "Cortina Access / Realtek RTL9607DQ QSPI controller driver"
+	depends on DM_SPI
+	select SPI_MEM
+	help
+	  Enable the PIO QSPI flash controller found on the Realtek RTL9607DQ
+	  (Taurus) SoC. Only the spi-mem op set used by SPI-NAND is supported.
+
 config CADENCE_QSPI
 	bool "Cadence QSPI driver"
 	select SPI_MEM
diff --git a/drivers/spi/Makefile b/drivers/spi/Makefile
