[ -e /etc/config/ubootenv ] && exit 0

touch /etc/config/ubootenv

. /lib/uboot-envtools.sh
. /lib/functions.sh

board=$(board_name)

case "$board" in
vsol,hg325ax30)
	ubootenv_add_mtd "env" "0x0" "0x40000" "0x20000" 2
	ubootenv_add_mtd "env2" "0x0" "0x40000" "0x20000" 2
	;;
esac

config_load ubootenv
config_foreach ubootenv_add_app_config

exit 0
