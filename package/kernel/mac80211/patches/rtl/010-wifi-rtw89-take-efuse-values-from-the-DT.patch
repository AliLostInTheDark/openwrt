From: Ifran Ali <khanu.i.i.k.2000@gmail.com>
Subject: [PATCH] wifi: rtw89: take the RFE type, crystal cap and MAC from the DT

Some boards (VSOL HG325AX30 with an RTL8852CE) ship the radio with a
blank efuse. The RFE type then reads as 255, no RF register tables
match and the radio does not work. Let the DT node of the PCI device
provide "realtek,rfe-type", "realtek,xtal-cap" and "mac-address"
instead, and use a random MAC when neither the DT nor the efuse has a
valid one. The properties are described in the realtek,rtw89-pci DT
binding.

Signed-off-by: Ifran Ali <khanu.i.i.k.2000@gmail.com>
--- a/drivers/net/wireless/realtek/rtw89/core.c
+++ b/drivers/net/wireless/realtek/rtw89/core.c
@@ -2,6 +2,8 @@
 /* Copyright(c) 2019-2020  Realtek Corporation
  */
 #include <linux/ip.h>
+#include <linux/of.h>
+#include <linux/of_net.h>
 #include <linux/sort.h>
 #include <linux/udp.h>
 
@@ -7177,6 +7179,28 @@ wake_queue:
 	return ret;
 }
 
+/* Boards with a blank or unreadable efuse can supply the values from the DT. */
+static void rtw89_chip_efuse_dt_override(struct rtw89_dev *rtwdev)
+{
+	struct device_node *np = rtwdev->dev->of_node;
+	struct rtw89_efuse *efuse = &rtwdev->efuse;
+	u32 val;
+	u8 mac[ETH_ALEN];
+
+	if (!np)
+		return;
+
+	if (!of_get_mac_address(np, mac))
+		ether_addr_copy(efuse->addr, mac);
+	else if (!is_valid_ether_addr(efuse->addr))
+		eth_random_addr(efuse->addr);
+
+	if (!of_property_read_u32(np, "realtek,rfe-type", &val))
+		efuse->rfe_type = val;
+	if (!of_property_read_u32(np, "realtek,xtal-cap", &val))
+		efuse->xtal_cap = val;
+}
+
 static int rtw89_chip_efuse_info_setup(struct rtw89_dev *rtwdev)
 {
 	const struct rtw89_mac_gen_def *mac = rtwdev->chip->mac_def;
@@ -7190,6 +7214,8 @@ static int rtw89_chip_efuse_info_setup(s
 	if (ret)
 		return ret;
 
+	rtw89_chip_efuse_dt_override(rtwdev);
+
 	ret = mac->parse_phycap_map(rtwdev);
 	if (ret)
 		return ret;
