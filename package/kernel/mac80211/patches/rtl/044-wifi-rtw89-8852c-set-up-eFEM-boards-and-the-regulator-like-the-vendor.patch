From: Ifran Ali <khanu.i.i.k.2000@gmail.com>
Subject: [PATCH] wifi: rtw89: 8852c: set up eFEM boards and the regulator like the vendor

Four places where rtw89 left the RTL8852C in a different state from the
vendor driver, found by sweeping every BB/RF/MAC write of the vendor
halbb/halrf/mac code against rtw89:

- set_enable_bb_rf sets SPS_DIG_ON_CTRL0 ZCDC_H to 1; rtw89 left the
  reset value 3. Stock reads 1.
- With an external front-end module (RFE type above 50) the vendor
  never runs the internal DPK, which models the on-chip PA. Skip it.
- The vendor lowers the TSSI C upper limit (0x58d8) to 0x16c on
  internal-FEM boards only; eFEM boards keep 0x174 from the BB table,
  as on stock. rtw89's table parse wrote 0x16c on every board.
- After the channel and bandwidth are programmed the vendor restarts
  the LO IQ generator (RF 0xdd bit 3, RF 0xa0 bit 6). Do the same.

On the HG325AX30 (RFE 54) the registers now match stock. None of these
changes the per-start loss of 2SS TX quality seen on this board, which
the vendor driver shows too.

Signed-off-by: Ifran Ali <khanu.i.i.k.2000@gmail.com>
--- a/drivers/net/wireless/realtek/rtw89/reg.h
+++ b/drivers/net/wireless/realtek/rtw89/reg.h
@@ -8731,6 +8731,7 @@
 #define RR_MIXER 0x9f
 #define RR_MIXER_GN GENMASK(4, 3)
 #define RR_POW 0xa0
+#define RR_POW_IQG BIT(6)
 #define RR_POW_SYN GENMASK(3, 2)
 #define RR_POW_SYN_V1 GENMASK(3, 0)
 #define RR_LOGEN 0xa3
@@ -8766,6 +8767,7 @@
 #define RR_IQKPLL_MOD GENMASK(9, 8)
 #define RR_SYNLUT 0xdd
 #define RR_SYNLUT_MOD BIT(4)
+#define RR_SYNLUT_IQG BIT(3)
 #define RR_RCKD 0xde
 #define RR_RCKD_POW GENMASK(19, 13)
 #define RR_RCKD_BW BIT(2)
@@ -9863,6 +9865,8 @@
 #define B_P0_ADCFF_EN BIT(24)
 #define R_P1_TSSIC 0x7814
 #define B_P1_TSSIC_BYPASS BIT(11)
+#define R_TSSI_CLIM 0x58D8
+#define B_TSSI_CLIM_UP GENMASK(8, 0)
 #define R_P0_TSSI_TRK 0x5818
 #define B_P0_TSSI_TRK_EN BIT(30)
 #define B_P0_TSSI_RFC GENMASK(28, 27)
--- a/drivers/net/wireless/realtek/rtw89/rtw8852c_common.c
+++ b/drivers/net/wireless/realtek/rtw89/rtw8852c_common.c
@@ -1048,6 +1048,8 @@ static int __rtw8852cx_mac_enable_bb_rf(struct rtw89_dev *rtwdev)
 	rtw89_write8_set(rtwdev, R_AX_SYS_FUNC_EN,
 			 B_AX_FEN_BBRSTB | B_AX_FEN_BB_GLB_RSTN);
 
+	rtw89_write32_mask(rtwdev, R_AX_SPS_DIG_ON_CTRL0, B_AX_REG_ZCDC_H_MASK, 0x1);
+
 	rtw89_write32_set(rtwdev, R_AX_WLRF_CTRL, B_AX_AFC_AFEDIG);
 	rtw89_write32_clr(rtwdev, R_AX_WLRF_CTRL, B_AX_AFC_AFEDIG);
 	rtw89_write32_set(rtwdev, R_AX_WLRF_CTRL, B_AX_AFC_AFEDIG);
--- a/drivers/net/wireless/realtek/rtw89/rtw8852c_rfk.c
+++ b/drivers/net/wireless/realtek/rtw89/rtw8852c_rfk.c
@@ -2781,6 +2781,9 @@ static bool _dpk_bypass_check(struct rtw89_dev *rtwdev, enum rtw89_phy_idx phy,
 	} else if (fem->epa_6g && band == RTW89_BAND_6G) {
 		rtw89_debug(rtwdev, RTW89_DBG_RFK, "[DPK] Skip DPK due to 6G_ext_PA exist!!\n");
 		return true;
+	} else if (rtw89_rfe_has_efem(rtwdev)) {
+		rtw89_debug(rtwdev, RTW89_DBG_RFK, "[DPK] Skip DPK due to eFEM!!\n");
+		return true;
 	}
 
 	return false;
@@ -2941,6 +2944,11 @@ static void _tssi_ini_txpwr_ctrl_bb(struct rtw89_dev *rtwdev, enum rtw89_phy_idx
 	rtw89_rfk_parser_by_cond(rtwdev, path == RF_PATH_A,
 				 &rtw8852c_tssi_txpwr_ctrl_bb_defs_a_tbl,
 				 &rtw8852c_tssi_txpwr_ctrl_bb_defs_b_tbl);
+
+	/* eFEM boards keep the higher TSSI C upper limit of their BB table */
+	if (rtw89_rfe_has_efem(rtwdev))
+		rtw89_phy_write32_mask(rtwdev, R_TSSI_CLIM + (path << 13),
+				       B_TSSI_CLIM_UP, 0x174);
 }
 
 static void _tssi_ini_txpwr_ctrl_bb_he_tb(struct rtw89_dev *rtwdev,
@@ -4095,6 +4103,19 @@ void rtw8852c_lck_init(struct rtw89_dev *rtwdev)
 	_lck_keep_thermal(rtwdev);
 }
 
+/* Restart the LO IQ generator after the channel and bandwidth change */
+static void _toggle_iqg(struct rtw89_dev *rtwdev)
+{
+	rtw89_write_rf(rtwdev, RF_PATH_A, RR_SYNLUT, RR_SYNLUT_IQG, 0x1);
+	fsleep(20);
+	rtw89_write_rf(rtwdev, RF_PATH_A, RR_POW, RR_POW_IQG, 0x0);
+	fsleep(2);
+	rtw89_write_rf(rtwdev, RF_PATH_A, RR_POW, RR_POW_IQG, 0x1);
+	fsleep(2);
+	rtw89_write_rf(rtwdev, RF_PATH_A, RR_SYNLUT, RR_SYNLUT_IQG, 0x0);
+	fsleep(20);
+}
+
 static
 void rtw8852c_ctrl_bw_ch(struct rtw89_dev *rtwdev, enum rtw89_phy_idx phy,
 			 u8 central_ch, enum rtw89_band band,
@@ -4102,6 +4123,7 @@ void rtw8852c_ctrl_bw_ch(struct rtw89_dev *rtwdev, enum rtw89_phy_idx phy,
 {
 	_ctrl_ch(rtwdev, phy, central_ch, band);
 	_ctrl_bw(rtwdev, phy, bw);
+	_toggle_iqg(rtwdev);
 	_rxbb_bw(rtwdev, phy, bw);
 }
 
