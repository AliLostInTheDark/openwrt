From: Ifran Ali <khanu.i.i.k.2000@gmail.com>
Subject: [PATCH] wifi: rtw89: 8192xb: add TSSI

Enable TSSI on every channel switch, after IQK, as Realtek's
rtk_wifi6_ap driver does for this chip. The register tables come from
its 2.4 GHz eFEM flow and differ from the RTL8852C ones in the TSSI ADC
and AFE settings, the TX power control defaults, the DCK, the slope
origin and the alignment defaults, which are left at zero. The thermal
meter table is built from the TX power track firmware element and the
DE from the efuse, as on the RTL8852C. During a scan the TX AGC offset
is held.

Signed-off-by: Ifran Ali <khanu.i.i.k.2000@gmail.com>
---
--- a/drivers/net/wireless/realtek/rtw89/Makefile
+++ b/drivers/net/wireless/realtek/rtw89/Makefile
@@ -83,7 +83,8 @@ rtw89_8852ce-objs := rtw8852ce.o
 
 obj-$(CPTCFG_RTW89_8192XB) += rtw89_8192xb.o
 rtw89_8192xb-objs := rtw8192xb.o \
-		     rtw8192xb_rfk.o
+		     rtw8192xb_rfk.o \
+		     rtw8192xb_rfk_table.o
 
 obj-$(CPTCFG_RTW89_8192XBE) += rtw89_8192xbe.o
 rtw89_8192xbe-objs := rtw8192xbe.o
--- a/drivers/net/wireless/realtek/rtw89/rtw8192xb.c
+++ b/drivers/net/wireless/realtek/rtw89/rtw8192xb.c
@@ -1061,11 +1061,19 @@ static void rtw8192xb_rfk_channel(struct rtw89_dev *rtwdev,
 
 	rtw8192xb_rx_dck(rtwdev, phy_idx);
 	rtw8192xb_iqk(rtwdev, phy_idx, chanctx_idx);
+	rtw89_btc_ntfy_preserve_bt_time(rtwdev, 30);
+	rtw8192xb_tssi(rtwdev, phy_idx, chanctx_idx);
 	rtw8192xb_dpk(rtwdev);
 
 	rtw89_btc_ntfy_conn_rfk(rtwdev, false);
 }
 
+static void rtw8192xb_rfk_scan(struct rtw89_dev *rtwdev,
+			       struct rtw89_vif_link *rtwvif_link, bool start)
+{
+	rtw8192xb_tssi_default_txagc(rtwdev, start);
+}
+
 static void rtw8192xb_rfk_track(struct rtw89_dev *rtwdev)
 {
 	rtw8192xb_lck_track(rtwdev);
@@ -1264,7 +1272,7 @@ static const struct rtw89_chip_ops rtw8192xb_chip_ops = {
 	.rfk_init_late		= NULL,
 	.rfk_channel		= rtw8192xb_rfk_channel,
 	.rfk_band_changed	= NULL,
-	.rfk_scan		= NULL,
+	.rfk_scan		= rtw8192xb_rfk_scan,
 	.rfk_track		= rtw8192xb_rfk_track,
 	.power_trim		= rtw8852cx_power_trim,
 	.set_txpwr		= rtw8852cx_set_txpwr,
--- a/drivers/net/wireless/realtek/rtw89/rtw8192xb_rfk.c
+++ b/drivers/net/wireless/realtek/rtw89/rtw8192xb_rfk.c
@@ -5,10 +5,12 @@
 #include "chan.h"
 #include "coex.h"
 #include "debug.h"
+#include "fw.h"
 #include "phy.h"
 #include "reg.h"
 #include "rtw8192xb.h"
 #include "rtw8192xb_rfk.h"
+#include "rtw8192xb_rfk_table.h"
 
 enum adc_ck {
 	ADC_NA = 0,
@@ -1248,6 +1250,248 @@ void rtw8192xb_lck_init(struct rtw89_dev *rtwdev)
 	_lck_keep_thermal(rtwdev);
 }
 
+#define _TSSI_DE_MASK GENMASK(21, 12)
+static const u32 _tssi_de_cck_long[RF_PATH_NUM_8192XB] = {0x5858, 0x7858};
+static const u32 _tssi_de_cck_short[RF_PATH_NUM_8192XB] = {0x5860, 0x7860};
+static const u32 _tssi_de_mcs_20m[RF_PATH_NUM_8192XB] = {0x5838, 0x7838};
+static const u32 _tssi_de_mcs_40m[RF_PATH_NUM_8192XB] = {0x5840, 0x7840};
+static const u32 _tssi_de_mcs_80m[RF_PATH_NUM_8192XB] = {0x5848, 0x7848};
+static const u32 _tssi_de_mcs_80m_80m[RF_PATH_NUM_8192XB] = {0x5850, 0x7850};
+static const u32 _tssi_de_mcs_5m[RF_PATH_NUM_8192XB] = {0x5828, 0x7828};
+static const u32 _tssi_de_mcs_10m[RF_PATH_NUM_8192XB] = {0x5830, 0x7830};
+
+static void _tssi_set_sys(struct rtw89_dev *rtwdev, enum rtw89_rf_path path)
+{
+	rtw89_rfk_parser(rtwdev, &rtw8192xb_tssi_sys_defs_tbl);
+	rtw89_rfk_parser_by_cond(rtwdev, path == RF_PATH_A,
+				 &rtw8192xb_tssi_sys_defs_a_tbl,
+				 &rtw8192xb_tssi_sys_defs_b_tbl);
+}
+
+static void _tssi_set_tmeter_tbl(struct rtw89_dev *rtwdev, enum rtw89_rf_path path)
+{
+	struct rtw89_fw_txpwr_track_cfg *trk = rtwdev->fw.elm_info.txpwr_trk;
+	struct rtw89_tssi_info *tssi_info = &rtwdev->tssi;
+	static const u32 tmeter[] = {R_P0_TMETER, R_P1_TMETER};
+	static const u32 rfctm[] = {R_P0_RFCTM, R_P1_RFCTM};
+	static const u32 base[] = {R_P0_TSSI_BASE, R_TSSI_THOF};
+	u8 thermal = tssi_info->thermal[path];
+	const s8 *thm_up, *thm_down;
+	s8 thm_ofst[64] = {};
+	u8 i, j;
+
+	if (path == RF_PATH_A) {
+		thm_up = trk->delta[RTW89_FW_TXPWR_TRK_TYPE_2GA_P][0];
+		thm_down = trk->delta[RTW89_FW_TXPWR_TRK_TYPE_2GA_N][0];
+	} else {
+		thm_up = trk->delta[RTW89_FW_TXPWR_TRK_TYPE_2GB_P][0];
+		thm_down = trk->delta[RTW89_FW_TXPWR_TRK_TYPE_2GB_N][0];
+	}
+
+	rtw89_phy_write32_mask(rtwdev, tmeter[path], B_P0_TMETER_DIS, 0x0);
+	rtw89_phy_write32_mask(rtwdev, tmeter[path], B_P0_TMETER_TRK, 0x1);
+
+	if (thermal == 0xff) {
+		thermal = 32;
+	} else {
+		i = 0;
+		for (j = 0; j < 32; j++)
+			thm_ofst[j] = i < DELTA_SWINGIDX_SIZE ?
+				      -thm_down[i++] :
+				      -thm_down[DELTA_SWINGIDX_SIZE - 1];
+		i = 1;
+		for (j = 63; j >= 32; j--)
+			thm_ofst[j] = i < DELTA_SWINGIDX_SIZE ?
+				      thm_up[i++] :
+				      thm_up[DELTA_SWINGIDX_SIZE - 1];
+	}
+
+	rtw89_phy_write32_mask(rtwdev, tmeter[path], B_P0_TMETER, thermal);
+	rtw89_phy_write32_mask(rtwdev, rfctm[path], B_P0_RFCTM_VAL, thermal);
+
+	for (i = 0; i < 64; i += 4)
+		rtw89_phy_write32(rtwdev, base[path] + i,
+				  (u8)thm_ofst[i] | (u8)thm_ofst[i + 1] << 8 |
+				  (u8)thm_ofst[i + 2] << 16 | (u32)(u8)thm_ofst[i + 3] << 24);
+
+	rtw89_phy_write32_mask(rtwdev, rfctm[path], R_P0_RFCTM_RDY, 0x1);
+	rtw89_phy_write32_mask(rtwdev, rfctm[path], R_P0_RFCTM_RDY, 0x0);
+}
+
+static void _tssi_enable(struct rtw89_dev *rtwdev)
+{
+	struct rtw89_tssi_info *tssi_info = &rtwdev->tssi;
+	u8 i;
+
+	for (i = RF_PATH_A; i < RF_PATH_NUM_8192XB; i++) {
+		rtw89_rfk_parser_by_cond(rtwdev, i == RF_PATH_A,
+					 &rtw8192xb_tssi_track_defs_a_tbl,
+					 &rtw8192xb_tssi_track_defs_b_tbl);
+		rtw89_rfk_parser_by_cond(rtwdev, i == RF_PATH_A,
+					 &rtw8192xb_tssi_txagc_ofst_mv_avg_defs_a_tbl,
+					 &rtw8192xb_tssi_txagc_ofst_mv_avg_defs_b_tbl);
+		rtw89_rfk_parser_by_cond(rtwdev, i == RF_PATH_A,
+					 &rtw8192xb_tssi_enable_defs_a_tbl,
+					 &rtw8192xb_tssi_enable_defs_b_tbl);
+
+		tssi_info->base_thermal[i] =
+			ewma_thermal_read(&rtwdev->phystat.avg_thermal[i]);
+		rtwdev->is_tssi_mode[i] = true;
+	}
+}
+
+static void _tssi_disable(struct rtw89_dev *rtwdev)
+{
+	rtw89_rfk_parser(rtwdev, &rtw8192xb_tssi_disable_defs_a_tbl);
+	rtw89_rfk_parser(rtwdev, &rtw8192xb_tssi_disable_defs_b_tbl);
+	rtwdev->is_tssi_mode[RF_PATH_A] = false;
+	rtwdev->is_tssi_mode[RF_PATH_B] = false;
+}
+
+static u32 _tssi_get_cck_group(u8 ch)
+{
+	switch (ch) {
+	case 1 ... 2:
+		return 0;
+	case 3 ... 5:
+		return 1;
+	case 6 ... 8:
+		return 2;
+	case 9 ... 11:
+		return 3;
+	case 12 ... 13:
+		return 4;
+	case 14:
+		return 5;
+	}
+
+	return 0;
+}
+
+static u32 _tssi_get_ofdm_group(u8 ch)
+{
+	switch (ch) {
+	case 1 ... 2:
+		return 0;
+	case 3 ... 5:
+		return 1;
+	case 6 ... 8:
+		return 2;
+	case 9 ... 11:
+		return 3;
+	case 12 ... 14:
+		return 4;
+	}
+
+	return 0;
+}
+
+static u32 _tssi_get_trim_group(u8 ch)
+{
+	return ch <= 8 ? 0 : 1;
+}
+
+static void _tssi_set_efuse_to_de(struct rtw89_dev *rtwdev,
+				  const struct rtw89_chan *chan)
+{
+	struct rtw89_tssi_info *tssi_info = &rtwdev->tssi;
+	u8 ch = chan->channel;
+	s8 trim_de;
+	s32 val;
+	u8 i;
+
+	for (i = RF_PATH_A; i < RF_PATH_NUM_8192XB; i++) {
+		trim_de = tssi_info->tssi_trim[i][_tssi_get_trim_group(ch)];
+
+		val = tssi_info->tssi_cck[i][_tssi_get_cck_group(ch)] + trim_de;
+		rtw89_phy_write32_mask(rtwdev, _tssi_de_cck_long[i], _TSSI_DE_MASK, val);
+		rtw89_phy_write32_mask(rtwdev, _tssi_de_cck_short[i], _TSSI_DE_MASK, val);
+
+		val = tssi_info->tssi_mcs[i][_tssi_get_ofdm_group(ch)] + trim_de;
+		rtw89_phy_write32_mask(rtwdev, _tssi_de_mcs_20m[i], _TSSI_DE_MASK, val);
+		rtw89_phy_write32_mask(rtwdev, _tssi_de_mcs_40m[i], _TSSI_DE_MASK, val);
+		rtw89_phy_write32_mask(rtwdev, _tssi_de_mcs_80m[i], _TSSI_DE_MASK, val);
+		rtw89_phy_write32_mask(rtwdev, _tssi_de_mcs_80m_80m[i], _TSSI_DE_MASK, val);
+		rtw89_phy_write32_mask(rtwdev, _tssi_de_mcs_5m[i], _TSSI_DE_MASK, val);
+		rtw89_phy_write32_mask(rtwdev, _tssi_de_mcs_10m[i], _TSSI_DE_MASK, val);
+
+		rtw89_debug(rtwdev, RTW89_DBG_TSSI,
+			    "[TSSI] S%d ch=%d trim=%d cck_de=0x%x ofdm_de=0x%x\n",
+			    i, ch, trim_de,
+			    rtw89_phy_read32_mask(rtwdev, _tssi_de_cck_long[i], _TSSI_DE_MASK),
+			    rtw89_phy_read32_mask(rtwdev, _tssi_de_mcs_20m[i], _TSSI_DE_MASK));
+	}
+}
+
+void rtw8192xb_tssi(struct rtw89_dev *rtwdev, enum rtw89_phy_idx phy,
+		    enum rtw89_chanctx_idx chanctx_idx)
+{
+	const struct rtw89_chan *chan = rtw89_chan_get(rtwdev, chanctx_idx);
+	u8 i;
+
+	_tssi_disable(rtwdev);
+
+	for (i = RF_PATH_A; i < RF_PATH_NUM_8192XB; i++) {
+		bool a = i == RF_PATH_A;
+
+		_tssi_set_sys(rtwdev, i);
+		rtw89_rfk_parser_by_cond(rtwdev, a, &rtw8192xb_tssi_txpwr_ctrl_bb_defs_a_tbl,
+					 &rtw8192xb_tssi_txpwr_ctrl_bb_defs_b_tbl);
+		rtw89_rfk_parser_by_cond(rtwdev, a,
+					 &rtw8192xb_tssi_txpwr_ctrl_bb_he_tb_defs_a_tbl,
+					 &rtw8192xb_tssi_txpwr_ctrl_bb_he_tb_defs_b_tbl);
+		rtw89_rfk_parser_by_cond(rtwdev, a, &rtw8192xb_tssi_dck_defs_a_tbl,
+					 &rtw8192xb_tssi_dck_defs_b_tbl);
+		rtw89_rfk_parser_by_cond(rtwdev, a, &rtw8192xb_tssi_set_bbgain_split_defs_a_tbl,
+					 &rtw8192xb_tssi_set_bbgain_split_defs_b_tbl);
+		_tssi_set_tmeter_tbl(rtwdev, i);
+		rtw89_rfk_parser_by_cond(rtwdev, a, &rtw8192xb_tssi_slope_cal_org_defs_a_tbl,
+					 &rtw8192xb_tssi_slope_cal_org_defs_b_tbl);
+		rtw89_rfk_parser_by_cond(rtwdev, a, &rtw8192xb_tssi_set_aligk_default_defs_a_tbl,
+					 &rtw8192xb_tssi_set_aligk_default_defs_b_tbl);
+		rtw89_rfk_parser_by_cond(rtwdev, a, &rtw8192xb_tssi_slope_defs_a_tbl,
+					 &rtw8192xb_tssi_slope_defs_b_tbl);
+		rtw89_rfk_parser_by_cond(rtwdev, a, &rtw8192xb_tssi_run_slope_defs_a_tbl,
+					 &rtw8192xb_tssi_run_slope_defs_b_tbl);
+	}
+
+	_tssi_enable(rtwdev);
+	_tssi_set_efuse_to_de(rtwdev, chan);
+}
+
+void rtw8192xb_tssi_default_txagc(struct rtw89_dev *rtwdev, bool scan_start)
+{
+	struct rtw89_tssi_info *tssi_info = &rtwdev->tssi;
+	static const u32 txagc[] = {R_TXAGC_BB, R_TXAGC_BB_S1};
+	static const u32 trk[] = {R_P0_TSSI_TRK, R_P1_TSSI_TRK};
+	u32 ofst;
+	u8 i, j;
+
+	if (!rtwdev->is_tssi_mode[RF_PATH_A] && !rtwdev->is_tssi_mode[RF_PATH_B])
+		return;
+
+	for (i = RF_PATH_A; i < RF_PATH_NUM_8192XB; i++) {
+		if (!scan_start) {
+			rtw89_phy_write32_mask(rtwdev, trk[i], B_P0_TSSI_OFT,
+					       tssi_info->default_txagc_offset[i]);
+			rtw89_phy_write32_mask(rtwdev, trk[i], B_P0_TSSI_OFT_EN, 0x0);
+			rtw89_phy_write32_mask(rtwdev, trk[i], B_P0_TSSI_OFT_EN, 0x1);
+			continue;
+		}
+
+		ofst = rtw89_phy_read32_mask(rtwdev, txagc[i], B_TXAGC_BB_OFT);
+		if (ofst == 0xc000 || ofst == 0x0)
+			continue;
+
+		for (j = 0; j < 6; j++) {
+			tssi_info->default_txagc_offset[i] =
+				rtw89_phy_read32_mask(rtwdev, txagc[i], B_TXAGC_BB);
+			if (tssi_info->default_txagc_offset[i])
+				break;
+		}
+	}
+}
+
 /* The vendor driver skips DPK with an external PA and keeps the DPD off. */
 void rtw8192xb_dpk(struct rtw89_dev *rtwdev)
 {
--- a/drivers/net/wireless/realtek/rtw89/rtw8192xb_rfk.h
+++ b/drivers/net/wireless/realtek/rtw89/rtw8192xb_rfk.h
@@ -15,6 +15,9 @@ void rtw8192xb_iqk(struct rtw89_dev *rtwdev, enum rtw89_phy_idx phy_idx,
 		   enum rtw89_chanctx_idx chanctx_idx);
 void rtw8192xb_lck_init(struct rtw89_dev *rtwdev);
 void rtw8192xb_lck_track(struct rtw89_dev *rtwdev);
+void rtw8192xb_tssi(struct rtw89_dev *rtwdev, enum rtw89_phy_idx phy,
+		    enum rtw89_chanctx_idx chanctx_idx);
+void rtw8192xb_tssi_default_txagc(struct rtw89_dev *rtwdev, bool scan_start);
 void rtw8192xb_dpk(struct rtw89_dev *rtwdev);
 void rtw8192xb_set_channel_rf(struct rtw89_dev *rtwdev,
 			      const struct rtw89_chan *chan,
