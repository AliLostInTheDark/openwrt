 	.rfk_band_changed	= NULL,
 	.rfk_scan		= NULL,
-	.rfk_track		= NULL,
+	.rfk_track		= rtw8192xb_rfk_track,
 	.power_trim		= rtw8852cx_power_trim,
 	.set_txpwr		= rtw8852cx_set_txpwr,
 	.set_txpwr_ctrl		= rtw8852cx_set_txpwr_ctrl,
