@@ -1175,6 +1175,79 @@ void rtw8192xb_iqk(struct rtw89_dev *rtwdev, enum rtw89_phy_idx phy_idx,
 	rtw89_btc_ntfy_wl_rfk(rtwdev, phy_map, BTC_WRFKT_IQK, BTC_WRFK_STOP);
 }
 
+#define RTW8192XB_LCK_TH 8
+
+static void _lck_keep_thermal(struct rtw89_dev *rtwdev)
+{
+	struct rtw89_lck_info *lck = &rtwdev->lck;
+	u8 path;
+
+	for (path = RF_PATH_A; path < RF_PATH_NUM_8192XB; path++)
+		lck->thermal[path] =
+			ewma_thermal_read(&rtwdev->phystat.avg_thermal[path]);
+}
+
+static void _lck(struct rtw89_dev *rtwdev)
+{
+	u32 rf_reg5[RF_PATH_NUM_8192XB], rf_reg0[RF_PATH_NUM_8192XB];
+	u32 rf_reg18, val;
+	u8 path;
+	int ret;
+
+	rtw89_debug(rtwdev, RTW89_DBG_RFK_TRACK, "[LCK] DO LCK\n");
+
+	rf_reg18 = rtw89_read_rf(rtwdev, RF_PATH_A, RR_CFGCH, RFREG_MASK);
+	for (path = RF_PATH_A; path < RF_PATH_NUM_8192XB; path++) {
+		rf_reg5[path] = rtw89_read_rf(rtwdev, path, RR_RSV1, RFREG_MASK);
+		rf_reg0[path] = rtw89_read_rf(rtwdev, path, RR_MOD, RFREG_MASK);
+		rtw89_write_rf(rtwdev, path, RR_MOD, RR_MOD_MASK, RR_MOD_V_RX);
+		rtw89_write_rf(rtwdev, path, RR_RSV1, RFREG_MASK, 0x0);
+	}
+
+	rtw89_write_rf(rtwdev, RF_PATH_A, RR_LCK_TRG, RR_LCK_TRGSEL, 0x1);
+	rtw89_write_rf(rtwdev, RF_PATH_A, RR_CFGCH, RFREG_MASK, rf_reg18);
+	rtw89_write_rf(rtwdev, RF_PATH_A, RR_LCK_TRG, RR_LCK_TRGSEL, 0x0);
+
+	ret = read_poll_timeout_atomic(rtw89_read_rf, val, !val, 1, 1000, false,
+				       rtwdev, RF_PATH_A, RR_LPF, RR_LPF_BUSY);
+	if (ret)
+		rtw89_debug(rtwdev, RTW89_DBG_RFK_TRACK, "[LCK] LCK timeout\n");
+
+	for (path = RF_PATH_A; path < RF_PATH_NUM_8192XB; path++) {
+		rtw89_write_rf(rtwdev, path, RR_MOD, RFREG_MASK, rf_reg0[path]);
+		rtw89_write_rf(rtwdev, path, RR_RSV1, RFREG_MASK, rf_reg5[path]);
+	}
+
+	_lck_keep_thermal(rtwdev);
+}
+
+void rtw8192xb_lck_track(struct rtw89_dev *rtwdev)
+{
+	struct rtw89_lck_info *lck = &rtwdev->lck;
+	u8 cur_thermal;
+	int delta;
+	u8 path;
+
+	for (path = RF_PATH_A; path < RF_PATH_NUM_8192XB; path++) {
+		cur_thermal = ewma_thermal_read(&rtwdev->phystat.avg_thermal[path]);
+		delta = abs((int)cur_thermal - lck->thermal[path]);
+
+		rtw89_debug(rtwdev, RTW89_DBG_RFK_TRACK,
+			    "[LCK] path=%d current thermal=0x%x delta=0x%x\n",
+			    path, cur_thermal, delta);
+
+		if (delta >= RTW8192XB_LCK_TH) {
+			_lck(rtwdev);
+			return;
+		}
+	}
+}
+
+void rtw8192xb_lck_init(struct rtw89_dev *rtwdev)
+{
+	_lck_keep_thermal(rtwdev);
+}
