From: Ifran Ali <khanu.i.i.k.2000@gmail.com>
Subject: [PATCH] wifi: rtw89: 8192xb: add IQK

Run TX/RX IQ calibration and LO leakage calibration on every channel
switch, following Realtek's rtk_wifi6_ap driver for this chip. The flow
is the RTL8852C one restricted to 2.4 GHz wideband IQK, with these
differences:
- TX groups 1 to 3 only, with the 2.4 GHz gains of this chip;
- RXK with the RF IQK mode 0xa and the RX clock forced to 480 MHz on CAV
  parts (960 MHz otherwise), with the ADC decimation cleared;
- the RX AGC one-shot uses command 0x708;
- a calibration fails on the NCTL report flag once the KIP is ready.

Signed-off-by: Ifran Ali <khanu.i.i.k.2000@gmail.com>
---
--- a/drivers/net/wireless/realtek/rtw89/rtw8192xb.c
+++ b/drivers/net/wireless/realtek/rtw89/rtw8192xb.c
@@ -1052,9 +1052,17 @@ static void rtw8192xb_rfk_init(struct rtw89_dev *rtwdev)
 static void rtw8192xb_rfk_channel(struct rtw89_dev *rtwdev,
 				  struct rtw89_vif_link *rtwvif_link)
 {
-	rtw8192xb_mcc_get_ch_info(rtwdev, rtwvif_link->phy_idx);
-	rtw8192xb_rx_dck(rtwdev, rtwvif_link->phy_idx);
+	enum rtw89_chanctx_idx chanctx_idx = rtwvif_link->chanctx_idx;
+	enum rtw89_phy_idx phy_idx = rtwvif_link->phy_idx;
+
+	rtw8192xb_mcc_get_ch_info(rtwdev, phy_idx);
+	rtw89_btc_ntfy_conn_rfk(rtwdev, true);
+
+	rtw8192xb_rx_dck(rtwdev, phy_idx);
+	rtw8192xb_iqk(rtwdev, phy_idx, chanctx_idx);
 	rtw8192xb_dpk(rtwdev);
+
+	rtw89_btc_ntfy_conn_rfk(rtwdev, false);
 }
 
 static void rtw8192xb_bb_cfg_rx_path(struct rtw89_dev *rtwdev, u8 rx_path)
--- a/drivers/net/wireless/realtek/rtw89/rtw8192xb_rfk.c
+++ b/drivers/net/wireless/realtek/rtw89/rtw8192xb_rfk.c
@@ -607,6 +607,574 @@ void rtw8192xb_rx_dck(struct rtw89_dev *rtwdev, enum rtw89_phy_idx phy)
 	rtw89_phy_write32(rtwdev, R_NCTL_RW, 0x0);
 }
 
+#define RTW8192XB_IQK_VER 0x7
+#define RTW8192XB_NCTL_VER 0xa
+#define RTW8192XB_IQK_SS 2
+#define TXK_GROUP_NR 4
+#define RXK_GROUP_NR 4
+
+enum rtw8192xb_iqk_type {
+	ID_TXAGC,
+	ID_G_FLOK_COARSE,
+	ID_G_FLOK_FINE,
+	ID_FLOK_VBUFFER,
+	ID_TXK,
+	ID_RXAGC,
+	ID_RXK,
+	ID_IQK_RESTORE,
+};
+
+static const u32 rtw8192xb_backup_bb_regs[] = {
+	0x2344, 0xc0d4, 0xc0d8, 0xc0c4, 0xc0e8, 0xc0ec,
+	0xc1d4, 0xc1d8, 0xc1c4, 0xc1e8, 0xc1ec
+};
+
+static const u32 rtw8192xb_backup_rf_regs[] = {
+	0xdc, 0xef, 0xde, 0x0, 0x1e, 0x5, 0x10005
+};
+
+#define BACKUP_BB_REGS_NR ARRAY_SIZE(rtw8192xb_backup_bb_regs)
+#define BACKUP_RF_REGS_NR ARRAY_SIZE(rtw8192xb_backup_rf_regs)
+
+static const u32 _txk_g_track_range[TXK_GROUP_NR] = {0x4, 0x4, 0x6, 0x6};
+static const u32 _txk_g_gain_bb[TXK_GROUP_NR] = {0x14, 0x14, 0x08, 0x0e};
+static const u32 _rxk_g_idxrxgain[RXK_GROUP_NR] = {0x150, 0x158, 0x2d0, 0x2d8};
+
+static void _rfk_backup_bb_reg(struct rtw89_dev *rtwdev, u32 backup_bb_reg_val[])
+{
+	u32 i;
+
+	for (i = 0; i < BACKUP_BB_REGS_NR; i++)
+		backup_bb_reg_val[i] =
+			rtw89_phy_read32_mask(rtwdev, rtw8192xb_backup_bb_regs[i],
+					      MASKDWORD);
+}
+
+static void _rfk_backup_rf_reg(struct rtw89_dev *rtwdev, u32 backup_rf_reg_val[],
+			       u8 rf_path)
+{
+	u32 i;
+
+	for (i = 0; i < BACKUP_RF_REGS_NR; i++)
+		backup_rf_reg_val[i] =
+			rtw89_read_rf(rtwdev, rf_path,
+				      rtw8192xb_backup_rf_regs[i], RFREG_MASK);
+}
+
+static void _rfk_restore_bb_reg(struct rtw89_dev *rtwdev, u32 backup_bb_reg_val[])
+{
+	u32 i;
+
+	for (i = 0; i < BACKUP_BB_REGS_NR; i++)
+		rtw89_phy_write32_mask(rtwdev, rtw8192xb_backup_bb_regs[i],
+				       MASKDWORD, backup_bb_reg_val[i]);
+}
+
+static void _rfk_restore_rf_reg(struct rtw89_dev *rtwdev, u32 backup_rf_reg_val[],
+				u8 rf_path)
+{
+	u32 i;
+
+	for (i = 0; i < BACKUP_RF_REGS_NR; i++)
+		rtw89_write_rf(rtwdev, rf_path, rtw8192xb_backup_rf_regs[i],
+			       RFREG_MASK, backup_rf_reg_val[i]);
+}
+
+static void _wait_rx_mode(struct rtw89_dev *rtwdev)
+{
+	u32 rf_mode;
+	u8 path;
+	int ret;
+
+	for (path = RF_PATH_A; path < RF_PATH_NUM_8192XB; path++) {
+		ret = read_poll_timeout_atomic(rtw89_read_rf, rf_mode, rf_mode != 2,
+					       2, 5000, false, rtwdev, path, RR_MOD,
+					       RR_MOD_MASK);
+		rtw89_debug(rtwdev, RTW89_DBG_RFK,
+			    "[RFK] Wait S%d to Rx mode!! (ret = %d)\n", path, ret);
+	}
+}
+
+static void _disable_rxagc(struct rtw89_dev *rtwdev, u8 path, u8 en_rxgac)
+{
+	if (path == RF_PATH_A)
+		rtw89_phy_write32_mask(rtwdev, R_P0_AGC_CTL, B_P0_AGC_EN, en_rxgac);
+	else
+		rtw89_phy_write32_mask(rtwdev, R_P1_AGC_CTL, B_P1_AGC_EN, en_rxgac);
+}
+
+static bool _iqk_check_cal(struct rtw89_dev *rtwdev, u8 path)
+{
+	bool fail = true;
+	u32 val;
+	int ret;
+
+	ret = read_poll_timeout_atomic(rtw89_phy_read32_mask, val, val == 0x55,
+				       1, 8200, false, rtwdev, R_RFK_ST, MASKBYTE0);
+	if (ret) {
+		rtw89_debug(rtwdev, RTW89_DBG_RFK, "[IQK]S%d NCTL1 timeout\n", path);
+		goto out;
+	}
+
+	fsleep(5);
+	ret = read_poll_timeout_atomic(rtw89_phy_read32_mask, val, val == 0x8000,
+				       1, 200, false, rtwdev, R_RPT_COM, B_RPT_COM_RDY);
+	if (ret) {
+		rtw89_debug(rtwdev, RTW89_DBG_RFK, "[IQK]S%d NCTL2 timeout\n", path);
+		goto out;
+	}
+
+	fsleep(10);
+	fail = rtw89_phy_read32_mask(rtwdev, R_NCTL_RPT, B_NCTL_RPT_FLG);
+out:
+	rtw89_phy_write32_clr(rtwdev, R_NCTL_N1, MASKBYTE0);
+
+	return fail;
+}
+
+static bool _iqk_one_shot(struct rtw89_dev *rtwdev, u8 path, u8 ktype)
+{
+	struct rtw89_iqk_info *iqk_info = &rtwdev->iqk;
+	u32 addr_rfc_ctl = R_UPD_CLK + (path << 13);
+	u32 iqk_cmd;
+	bool fail;
+
+	switch (ktype) {
+	case ID_TXAGC:
+		iqk_cmd = 0x008 | (1 << (4 + path)) | (path << 1);
+		break;
+	case ID_G_FLOK_COARSE:
+		rtw89_phy_write32_mask(rtwdev, addr_rfc_ctl, B_IQK_RFC_ON, 0x1);
+		iqk_cmd = 0x108 | (1 << (4 + path));
+		break;
+	case ID_G_FLOK_FINE:
+		rtw89_phy_write32_mask(rtwdev, addr_rfc_ctl, B_IQK_RFC_ON, 0x1);
+		iqk_cmd = 0x208 | (1 << (4 + path));
+		break;
+	case ID_FLOK_VBUFFER:
+		rtw89_phy_write32_mask(rtwdev, addr_rfc_ctl, B_IQK_RFC_ON, 0x1);
+		iqk_cmd = 0x308 | (1 << (4 + path));
+		break;
+	case ID_TXK:
+		iqk_cmd = 0x008 | (1 << (4 + path)) |
+			  (((0x8 + iqk_info->iqk_bw[path]) & 0xf) << 8);
+		break;
+	case ID_RXAGC:
+		rtw89_phy_write32_mask(rtwdev, addr_rfc_ctl, B_IQK_RFC_ON, 0x1);
+		iqk_cmd = 0x708 | (1 << (4 + path));
+		break;
+	case ID_RXK:
+		rtw89_phy_write32_mask(rtwdev, addr_rfc_ctl, B_IQK_RFC_ON, 0x1);
+		iqk_cmd = 0x008 | (1 << (4 + path)) |
+			  (((0xc + iqk_info->iqk_bw[path]) & 0xf) << 8);
+		break;
+	case ID_IQK_RESTORE:
+		iqk_cmd = 0x1208 | (1 << (4 + path));
+		break;
+	default:
+		return false;
+	}
+
+	rtw89_phy_write32(rtwdev, R_NCTL_CFG, iqk_cmd + 1);
+	udelay(1);
+	fail = _iqk_check_cal(rtwdev, path);
+	rtw89_phy_write32_mask(rtwdev, addr_rfc_ctl, B_IQK_RFC_ON, 0x0);
+
+	return fail;
+}
+
+static void _iqk_set_txig(struct rtw89_dev *rtwdev, u8 path, u32 tg, u32 iqsw)
+{
+	rtw89_write_rf(rtwdev, path, RR_TXIG, RR_TXIG_TG, tg);
+	rtw89_phy_write32(rtwdev, R_KIP_IQP + (path << 8), iqsw);
+}
+
+static bool _lok_finetune_check(struct rtw89_dev *rtwdev, u8 path)
+{
+	struct rtw89_iqk_info *iqk_info = &rtwdev->iqk;
+	u8 ch = (iqk_info->iqk_times / 2) % 2;
+	u32 core_i, core_q, vbuff_i, vbuff_q;
+	bool is_fail1, is_fail2;
+	u32 val;
+
+	val = rtw89_read_rf(rtwdev, path, RR_TXMO, RFREG_MASK);
+	core_i = FIELD_GET(RR_TXMO_COI, val);
+	core_q = FIELD_GET(RR_TXMO_COQ, val);
+	is_fail1 = core_i < 0x2 || core_i > 0x1d || core_q < 0x2 || core_q > 0x1d;
+	iqk_info->lok_idac[ch][path] = val;
+
+	val = rtw89_read_rf(rtwdev, path, RR_LOKVB, RFREG_MASK);
+	vbuff_i = FIELD_GET(RR_LOKVB_COI, val);
+	vbuff_q = FIELD_GET(RR_LOKVB_COQ, val);
+	is_fail2 = vbuff_i < 0x2 || vbuff_i > 0x3d || vbuff_q < 0x2 || vbuff_q > 0x3d;
+	iqk_info->lok_vbuf[ch][path] = val;
+
+	return is_fail1 || is_fail2;
+}
+
+static bool _iqk_lok(struct rtw89_dev *rtwdev, u8 path)
+{
+	struct rtw89_iqk_info *iqk_info = &rtwdev->iqk;
+
+	rtw89_phy_write32_mask(rtwdev, R_IQK_DIF4, B_IQK_DIF4_TXT, 0x021);
+
+	_iqk_set_txig(rtwdev, path, 0x6, 0x09);
+	iqk_info->lok_cor_fail[0][path] = _iqk_one_shot(rtwdev, path, ID_G_FLOK_COARSE);
+	_iqk_set_txig(rtwdev, path, 0x12, 0x1b);
+	_iqk_one_shot(rtwdev, path, ID_FLOK_VBUFFER);
+
+	_iqk_set_txig(rtwdev, path, 0x6, 0x09);
+	iqk_info->lok_fin_fail[0][path] = _iqk_one_shot(rtwdev, path, ID_G_FLOK_FINE);
+	_iqk_set_txig(rtwdev, path, 0x12, 0x1b);
+	_iqk_one_shot(rtwdev, path, ID_FLOK_VBUFFER);
+
+	return _lok_finetune_check(rtwdev, path);
+}
+
+static void _iqk_txk_setting(struct rtw89_dev *rtwdev, u8 path)
+{
+	rtw89_write_rf(rtwdev, path, RR_TXG1, RR_TXG1_ATT2, 0x0);
+	rtw89_write_rf(rtwdev, path, RR_TXG1, RR_TXG1_ATT1, 0x0);
+	rtw89_write_rf(rtwdev, path, RR_TXG2, RR_TXG2_ATT0, 0x1);
+	rtw89_write_rf(rtwdev, path, RR_TXGA, RR_TXGA_LOK_EXT, 0x0);
+	rtw89_write_rf(rtwdev, path, RR_LUTWE, RR_LUTWE_LOK, 0x1);
+	rtw89_write_rf(rtwdev, path, RR_LUTWA, RR_LUTWA_M1, 0x00);
+	rtw89_write_rf(rtwdev, path, RR_MOD, RFREG_MASK, 0x403e1);
+	fsleep(10);
+	rtw89_write_rf(rtwdev, path, RR_TXIG, RR_TXIG_GR0, 0x0);
+	rtw89_write_rf(rtwdev, path, RR_TXIG, RR_TXIG_GR1, 0x6);
+	rtw89_write_rf(rtwdev, path, RR_TXIG, RR_TXIG_TG, 0x6);
+}
+
+static bool _txk_group_sel(struct rtw89_dev *rtwdev, u8 path)
+{
+	struct rtw89_iqk_info *iqk_info = &rtwdev->iqk;
+	bool kfail = false;
+	bool fail;
+	u8 gp;
+
+	for (gp = 1; gp < TXK_GROUP_NR; gp++) {
+		rtw89_write_rf(rtwdev, path, RR_TXIG, RR_TXIG_GR0, 0x0);
+		rtw89_write_rf(rtwdev, path, RR_TXIG, RR_TXIG_GR1,
+			       _txk_g_track_range[gp]);
+		rtw89_write_rf(rtwdev, path, RR_TXIG, RR_TXIG_TG, _txk_g_gain_bb[gp]);
+		rtw89_phy_write32_mask(rtwdev, R_KIP_IQP + (path << 8),
+				       B_KIP_IQP_IQSW, 0x12);
+
+		rtw89_phy_write32_mask(rtwdev, R_CFIR_LUT + (path << 8),
+				       B_CFIR_LUT_SEL, 0x1);
+		rtw89_phy_write32_mask(rtwdev, R_CFIR_LUT + (path << 8),
+				       B_CFIR_LUT_G3, 0x1);
+		rtw89_phy_write32_mask(rtwdev, R_CFIR_LUT + (path << 8),
+				       B_CFIR_LUT_G2, 0x0);
+		rtw89_phy_write32_mask(rtwdev, R_CFIR_LUT + (path << 8),
+				       B_CFIR_LUT_GP, gp);
+		rtw89_phy_write32_mask(rtwdev, R_NCTL_N1, B_NCTL_N1_CIP, 0x00);
+
+		fail = _iqk_one_shot(rtwdev, path, ID_TXK);
+		rtw89_phy_write32_mask(rtwdev, R_IQKINF, BIT(8 + gp + path * 4), fail);
+		kfail |= fail;
+	}
+
+	iqk_info->nb_txcfir[path] = kfail ? 0x40000002 : 0x40000000;
+	iqk_info->is_wb_txiqk[path] = !kfail;
+
+	return kfail;
+}
+
+static void _iqk_rxk_setting(struct rtw89_dev *rtwdev, u8 path)
+{
+	bool cav = rtwdev->hal.cv == CHIP_CAV;
+
+	rtw89_phy_write32_mask(rtwdev, R_ADC_FIFO, B_ADC_FIFO_RXK,
+			       path == RF_PATH_A ? 0x0101 : 0x0202);
+
+	rtw89_phy_write32_mask(rtwdev, R_UPD_CLK + (path << 13), B_DPD_GDIS, 0x1);
+	_rxck_force(rtwdev, path, true, cav ? ADC_480M : ADC_960M);
+	rtw89_phy_write32_mask(rtwdev, R_UPD_CLK + (path << 13), B_ACK_VAL, 0x0);
+	rtw89_phy_write32_mask(rtwdev, R_DCIM + (path << 8), B_DCIM_FR, cav ? 0x0 : 0x2);
+	rtw89_write_rf(rtwdev, path, RR_RXBB2, RR_RXBB2_CKT, 0x1);
+	rtw89_phy_write32_mask(rtwdev, R_P0_NRBW + (path << 13), B_P0_NRBW_DBG, 0x1);
+
+	rtw89_phy_write32_mask(rtwdev, R_ANAPAR_PW15, B_ANAPAR_PW15, 0x0f);
+	rtw89_phy_write32_mask(rtwdev, R_ANAPAR_PW15, B_ANAPAR_PW15, 0x03);
+	rtw89_phy_write32_mask(rtwdev, R_ANAPAR, B_ANAPAR_15, 0x0001);
+	rtw89_phy_write32_mask(rtwdev, R_ANAPAR, B_ANAPAR_15, 0x0041);
+
+	rtw89_phy_write32_mask(rtwdev, R_ADC_FIFO, B_ADC_FIFO_RXK,
+			       path == RF_PATH_A ? 0x1101 : 0x2202);
+}
+
+static bool _rxk_group_sel(struct rtw89_dev *rtwdev, u8 path)
+{
+	struct rtw89_iqk_info *iqk_info = &rtwdev->iqk;
+	bool kfail = false;
+	bool fail;
+	u32 tmp;
+	u8 gp;
+
+	if (path == RF_PATH_B) {
+		rtw89_write_rf(rtwdev, RF_PATH_B, RR_IQKPLL, RR_IQKPLL_MOD, 0x3);
+		tmp = rtw89_read_rf(rtwdev, RF_PATH_B, RR_CHTR, RR_CHTR_MOD);
+		rtw89_write_rf(rtwdev, RF_PATH_B, RR_RSV4, RR_RSV4_AGH, tmp);
+		tmp = rtw89_read_rf(rtwdev, RF_PATH_B, RR_CHTR, RR_CHTR_TXRX);
+		rtw89_write_rf(rtwdev, RF_PATH_B, RR_RSV4, RR_RSV4_PLLCH, tmp);
+	}
+
+	rtw89_write_rf(rtwdev, path, RR_MOD, RR_MOD_MASK, 0xc);
+	rtw89_write_rf(rtwdev, path, RR_RXG, RR_RXG_IQKMOD, 0xa);
+	fsleep(10);
+
+	for (gp = 0; gp < RXK_GROUP_NR; gp++) {
+		rtw89_write_rf(rtwdev, path, RR_MOD, RR_MOD_M_RXG, _rxk_g_idxrxgain[gp]);
+		rtw89_write_rf(rtwdev, path, RR_RXBB, RR_RXBB_VOBUF, 0x0);
+
+		rtw89_phy_write32_mask(rtwdev, R_CFIR_LUT + (path << 8),
+				       B_CFIR_LUT_SEL, 0x1);
+		rtw89_phy_write32_mask(rtwdev, R_CFIR_LUT + (path << 8),
+				       B_CFIR_LUT_G3, 0x0);
+		rtw89_phy_write32_mask(rtwdev, R_CFIR_LUT + (path << 8),
+				       B_CFIR_LUT_GP_V1, gp);
+
+		rtw89_write_rf(rtwdev, path, RR_RXKPLL, RFREG_MASK, 0x80013);
+		fsleep(200);
+		tmp = rtw89_read_rf(rtwdev, path, RR_MOD, RFREG_MASK);
+		rtw89_phy_write32_mask(rtwdev, R_IQK_DIF2, B_IQK_DIF2_RXPI, tmp);
+		rtw89_phy_write32_mask(rtwdev, R_IQK_RXA, B_IQK_RXAGC, gp);
+		rtw89_phy_write32_mask(rtwdev, R_IQK_DIF4, B_IQK_DIF4_RXT, 0x11);
+
+		_iqk_one_shot(rtwdev, path, ID_RXAGC);
+		fsleep(10);
+		fail = _iqk_one_shot(rtwdev, path, ID_RXK);
+		rtw89_phy_write32_mask(rtwdev, R_IQKINF, BIT(16 + gp + path * 4), fail);
+		kfail |= fail;
+	}
+
+	if (path == RF_PATH_B)
+		rtw89_write_rf(rtwdev, RF_PATH_B, RR_IQKPLL, RR_IQKPLL_MOD, 0x0);
+
+	iqk_info->nb_rxcfir[path] = kfail ? 0x40000002 : 0x40000000;
+	iqk_info->is_wb_rxiqk[path] = !kfail;
+
+	return kfail;
+}
+
+static void _iqk_info_iqk(struct rtw89_dev *rtwdev, u8 path)
+{
+	struct rtw89_iqk_info *iqk_info = &rtwdev->iqk;
+	u32 tmp;
+
+	rtw89_phy_write32_mask(rtwdev, R_IQKINF, B_IQKINF_FCOR << (path * 4),
+			       iqk_info->lok_cor_fail[0][path]);
+	rtw89_phy_write32_mask(rtwdev, R_IQKINF, B_IQKINF_FFIN << (path * 4),
+			       iqk_info->lok_fin_fail[0][path]);
+	rtw89_phy_write32_mask(rtwdev, R_IQKINF, B_IQKINF_FTX << (path * 4),
+			       iqk_info->iqk_tx_fail[0][path]);
+	rtw89_phy_write32_mask(rtwdev, R_IQKINF, B_IQKINF_F_RX << (path * 4),
+			       iqk_info->iqk_rx_fail[0][path]);
+
+	iqk_info->bp_iqkenable[path] =
+		rtw89_phy_read32_mask(rtwdev, R_IQK_RES + (path << 8), MASKDWORD);
+	iqk_info->bp_txkresult[path] =
+		rtw89_phy_read32_mask(rtwdev, R_TXIQC + (path << 8), MASKDWORD);
+	iqk_info->bp_rxkresult[path] =
+		rtw89_phy_read32_mask(rtwdev, R_RXIQC + (path << 8), MASKDWORD);
+
+	rtw89_phy_write32_mask(rtwdev, R_IQKINF2, B_IQKINF2_KCNT, iqk_info->iqk_times);
+	tmp = rtw89_phy_read32_mask(rtwdev, R_IQKINF, B_IQKINF_FAIL << (path * 4));
+	if (tmp)
+		iqk_info->iqk_fail_cnt++;
+	rtw89_phy_write32_mask(rtwdev, R_IQKINF2, B_IQKINF2_FCNT << (path * 4),
+			       iqk_info->iqk_fail_cnt);
+
+	rtw89_debug(rtwdev, RTW89_DBG_RFK,
+		    "[IQK]S%d LOK %d/%d TX %d RX %d, TXIQC 0x%x RXIQC 0x%x\n", path,
+		    iqk_info->lok_cor_fail[0][path], iqk_info->lok_fin_fail[0][path],
+		    iqk_info->iqk_tx_fail[0][path], iqk_info->iqk_rx_fail[0][path],
+		    iqk_info->bp_txkresult[path], iqk_info->bp_rxkresult[path]);
+}
+
+static void _iqk_by_path(struct rtw89_dev *rtwdev, u8 path)
+{
+	struct rtw89_iqk_info *iqk_info = &rtwdev->iqk;
+
+	_iqk_txk_setting(rtwdev, path);
+	_iqk_lok(rtwdev, path);
+	iqk_info->iqk_tx_fail[0][path] = _txk_group_sel(rtwdev, path);
+
+	_iqk_rxk_setting(rtwdev, path);
+	iqk_info->iqk_rx_fail[0][path] = _rxk_group_sel(rtwdev, path);
+
+	_iqk_info_iqk(rtwdev, path);
+}
+
+static void _iqk_get_ch_info(struct rtw89_dev *rtwdev, u8 path,
+			     enum rtw89_chanctx_idx chanctx_idx)
+{
+	const struct rtw89_chan *chan = rtw89_chan_get(rtwdev, chanctx_idx);
+	struct rtw89_iqk_info *iqk_info = &rtwdev->iqk;
+	u8 idx;
+
+	for (idx = 0; idx < RTW89_IQK_CHS_NR; idx++)
+		if (iqk_info->iqk_mcc_ch[idx][path] == 0)
+			break;
+	if (idx == RTW89_IQK_CHS_NR)
+		idx = (iqk_info->iqk_table_idx[path] + 1) % RTW89_IQK_CHS_NR;
+
+	iqk_info->iqk_band[path] = chan->band_type;
+	iqk_info->iqk_bw[path] = chan->band_width;
+	iqk_info->iqk_ch[path] = chan->channel;
+	iqk_info->iqk_mcc_ch[idx][path] = chan->channel;
+	iqk_info->iqk_table_idx[path] = 0;
+
+	rtw89_phy_write32_mask(rtwdev, R_IQKINF, B_IQKINF_VER, RTW8192XB_IQK_VER);
+	rtw89_phy_write32_mask(rtwdev, R_IQKCH, B_IQKCH_BAND << (path * 16),
+			       iqk_info->iqk_band[path]);
+	rtw89_phy_write32_mask(rtwdev, R_IQKCH, B_IQKCH_BW << (path * 16),
+			       iqk_info->iqk_bw[path]);
+	rtw89_phy_write32_mask(rtwdev, R_IQKCH, B_IQKCH_CH << (path * 16),
+			       iqk_info->iqk_ch[path]);
+	rtw89_phy_write32_mask(rtwdev, R_IQKINF2, B_IQKINF2_NCTLV, RTW8192XB_NCTL_VER);
+}
+
+static void _iqk_macbb_setting(struct rtw89_dev *rtwdev, u8 path)
+{
+	u32 rfc_ctl = R_UPD_CLK | (path << 13);
+
+	rtw89_write_rf(rtwdev, path, RR_BBDC, RR_BBDC_SEL, 0x0);
+	rtw89_phy_write32_mask(rtwdev, R_ADC_FIFO, B_ADC_FIFO_A0 << path, 0x1);
+	rtw89_phy_write32_mask(rtwdev, R_ADC_FIFO, B_ADC_FIFO_A1 << path, 0x0);
+	rtw89_phy_write32_mask(rtwdev, R_ADC_FIFO, B_ADC_FIFO_A2 << path, 0x1);
+	rtw89_phy_write32_mask(rtwdev, R_ADC_FIFO, B_ADC_FIFO_A3 << path, 0x0);
+	_disable_rxagc(rtwdev, path, 0x0);
+
+	rtw89_phy_write32(rtwdev, rfc_ctl, 0xf801fffd);
+	rtw89_phy_write32_mask(rtwdev, rfc_ctl, B_DPD_DIS, 0x1);
+	rtw89_phy_write32_mask(rtwdev, rfc_ctl, B_DAC_VAL, 0x1);
+	_txck_force(rtwdev, path, true, DAC_960M);
+	rtw89_phy_write32_mask(rtwdev, rfc_ctl, B_DPD_GDIS, 0x1);
+	_rxck_force(rtwdev, path, true, ADC_1920M);
+	rtw89_phy_write32_mask(rtwdev, rfc_ctl, B_ACK_VAL, 0x2);
+	rtw89_phy_write32_mask(rtwdev, R_DCIM + (path << 8), B_DCIM_FR, 0x0);
+	rtw89_phy_write32_mask(rtwdev, R_P0_NRBW | (path << 13), B_P0_NRBW_DBG, 0x1);
+
+	rtw89_phy_write32_mask(rtwdev, R_ANAPAR_PW15, B_ANAPAR_PW15, 0x1f);
+	rtw89_phy_write32_mask(rtwdev, R_ANAPAR_PW15, B_ANAPAR_PW15, 0x13);
+	rtw89_phy_write32_mask(rtwdev, R_ANAPAR, B_ANAPAR_15, 0x0001);
+	rtw89_phy_write32_mask(rtwdev, R_ANAPAR, B_ANAPAR_15, 0x0041);
+	rtw89_phy_write32_mask(rtwdev, R_ADC_FIFO, B_ADC_FIFO_A1 << path, 0x1);
+	rtw89_phy_write32_mask(rtwdev, R_ADC_FIFO, B_ADC_FIFO_A3 << path, 0x1);
+}
+
+static void _iqk_preset(struct rtw89_dev *rtwdev, u8 path)
+{
+	rtw89_write_rf(rtwdev, path, RR_RSV1, RR_RSV1_RST, 0x0);
+	rtw89_phy_write32(rtwdev, R_NCTL_RPT, 0x00000080);
+	rtw89_phy_write32(rtwdev, R_KIP_SYSCFG, 0x81ff010a);
+}
+
+static void _iqk_restore(struct rtw89_dev *rtwdev, u8 path)
+{
+	struct rtw89_iqk_info *iqk_info = &rtwdev->iqk;
+
+	rtw89_phy_write32(rtwdev, R_TXIQC + (path << 8), iqk_info->nb_txcfir[path]);
+	rtw89_phy_write32(rtwdev, R_RXIQC + (path << 8), iqk_info->nb_rxcfir[path]);
+	_iqk_one_shot(rtwdev, path, ID_IQK_RESTORE);
+
+	rtw89_phy_write32_mask(rtwdev, R_NCTL_N1, B_NCTL_N1_CIP, 0x00);
+	rtw89_phy_write32(rtwdev, R_NCTL_RPT, 0x00000000);
+	rtw89_phy_write32(rtwdev, R_KIP_SYSCFG, 0x80000000);
+	rtw89_write_rf(rtwdev, path, RR_LUTWE, RR_LUTWE_LOK, 0x0);
+	rtw89_write_rf(rtwdev, path, RR_MOD, RR_MOD_MASK, RR_MOD_V_RX);
+	rtw89_write_rf(rtwdev, path, RR_RSV1, RR_RSV1_RST, 0x1);
+}
+
+static void _iqk_afebb_restore(struct rtw89_dev *rtwdev, u8 path)
+{
+	rtw89_phy_write32_mask(rtwdev, R_P0_NRBW | (path << 13), B_P0_NRBW_DBG, 0x0);
+	rtw89_phy_write32_mask(rtwdev, R_ADC_FIFO, B_ADC_FIFO_A0 << path, 0x1);
+	rtw89_phy_write32_mask(rtwdev, R_ADC_FIFO, B_ADC_FIFO_A1 << path, 0x0);
+	rtw89_phy_write32_mask(rtwdev, R_ADC_FIFO, B_ADC_FIFO_A2 << path, 0x1);
+	rtw89_phy_write32_mask(rtwdev, R_ADC_FIFO, B_ADC_FIFO_A3 << path, 0x0);
+	rtw89_phy_write32(rtwdev, R_UPD_CLK | (path << 13), 0x00000000);
+	rtw89_phy_write32_mask(rtwdev, R_P0_RXCK | (path << 13), GENMASK(19, 12), 0x00);
+	rtw89_phy_write32_mask(rtwdev, R_ADC_FIFO, B_ADC_FIFO_A0 << path, 0x0);
+	rtw89_phy_write32_mask(rtwdev, R_ADC_FIFO, B_ADC_FIFO_A2 << path, 0x0);
+	rtw89_write_rf(rtwdev, path, RR_BBDC, RR_BBDC_SEL, 0x1);
+
+	_disable_rxagc(rtwdev, path, 0x1);
+}
+
+static void _doiqk(struct rtw89_dev *rtwdev, enum rtw89_phy_idx phy_idx, u8 path,
+		   enum rtw89_chanctx_idx chanctx_idx)
+{
+	u8 phy_map = rtw89_btc_phymap(rtwdev, phy_idx, RF_AB, chanctx_idx);
+	struct rtw89_iqk_info *iqk_info = &rtwdev->iqk;
+	u32 backup_rf_val[RTW8192XB_IQK_SS][BACKUP_RF_REGS_NR];
+	u32 backup_bb_val[BACKUP_BB_REGS_NR];
+
+	rtw89_btc_ntfy_wl_rfk(rtwdev, phy_map, BTC_WRFKT_IQK, BTC_WRFK_ONESHOT_START);
+
+	iqk_info->version = RTW8192XB_IQK_VER;
+	_iqk_get_ch_info(rtwdev, path, chanctx_idx);
+	_rfk_backup_bb_reg(rtwdev, backup_bb_val);
+	_rfk_backup_rf_reg(rtwdev, backup_rf_val[path], path);
+	_iqk_macbb_setting(rtwdev, path);
+	_iqk_preset(rtwdev, path);
+	_iqk_by_path(rtwdev, path);
+	_iqk_restore(rtwdev, path);
+	_iqk_afebb_restore(rtwdev, path);
+	_rfk_restore_bb_reg(rtwdev, backup_bb_val);
+	_rfk_restore_rf_reg(rtwdev, backup_rf_val[path], path);
+	iqk_info->iqk_times++;
+
+	rtw89_btc_ntfy_wl_rfk(rtwdev, phy_map, BTC_WRFKT_IQK, BTC_WRFK_ONESHOT_STOP);
+}
+
+static void _iqk_init(struct rtw89_dev *rtwdev)
+{
+	struct rtw89_iqk_info *iqk_info = &rtwdev->iqk;
+	u8 ch, path;
+
+	rtw89_phy_write32_clr(rtwdev, R_IQKINF, MASKDWORD);
+	if (iqk_info->is_iqk_init)
+		return;
+
+	iqk_info->is_iqk_init = true;
+	iqk_info->is_nbiqk = false;
+	iqk_info->iqk_times = 0x0;
+	for (ch = 0; ch < RTW89_IQK_CHS_NR; ch++) {
+		iqk_info->iqk_channel[ch] = 0x0;
+		for (path = 0; path < RTW8192XB_IQK_SS; path++) {
+			iqk_info->lok_cor_fail[ch][path] = false;
+			iqk_info->lok_fin_fail[ch][path] = false;
+			iqk_info->iqk_tx_fail[ch][path] = false;
+			iqk_info->iqk_rx_fail[ch][path] = false;
+			iqk_info->iqk_mcc_ch[ch][path] = 0x0;
+			iqk_info->iqk_table_idx[path] = 0x0;
+		}
+	}
+}
+
+void rtw8192xb_iqk(struct rtw89_dev *rtwdev, enum rtw89_phy_idx phy_idx,
+		   enum rtw89_chanctx_idx chanctx_idx)
+{
+	u8 phy_map = rtw89_btc_phymap(rtwdev, phy_idx, 0, chanctx_idx);
+	u32 tx_en;
+	u8 path;
+
+	rtw89_btc_ntfy_wl_rfk(rtwdev, phy_map, BTC_WRFKT_IQK, BTC_WRFK_START);
+	rtw89_chip_stop_sch_tx(rtwdev, phy_idx, &tx_en, RTW89_SCH_TX_SEL_ALL);
+	_wait_rx_mode(rtwdev);
+
+	_iqk_init(rtwdev);
+	for (path = RF_PATH_A; path < RF_PATH_NUM_8192XB; path++)
+		_doiqk(rtwdev, phy_idx, path, chanctx_idx);
+
+	rtw89_chip_resume_sch_tx(rtwdev, phy_idx, tx_en);
+	rtw89_btc_ntfy_wl_rfk(rtwdev, phy_map, BTC_WRFKT_IQK, BTC_WRFK_STOP);
+}
+
