+// SPDX-License-Identifier: GPL-2.0 OR BSD-3-Clause
+/* Copyright(c) 2019-2022  Realtek Corporation
+ */
+
+#include "chan.h"
+#include "debug.h"
+#include "phy.h"
+#include "reg.h"
+#include "rtw8192xb.h"
+#include "rtw8192xb_rfk.h"
+
+static void _rck(struct rtw89_dev *rtwdev, enum rtw89_rf_path path)
+{
+	u32 rf_reg5, rck_val;
+	u32 val;
+	int ret;
+
+	rf_reg5 = rtw89_read_rf(rtwdev, path, RR_RSV1, RFREG_MASK);
+
+	rtw89_write_rf(rtwdev, path, RR_RSV1, RR_RSV1_RST, 0x0);
+	rtw89_write_rf(rtwdev, path, RR_MOD, RR_MOD_MASK, RR_MOD_V_RX);
+
+	/* RCK trigger */
+	rtw89_write_rf(rtwdev, path, RR_RCKC, RFREG_MASK, 0x00240);
+
+	ret = read_poll_timeout_atomic(rtw89_read_rf, val, val, 2, 20,
+				       false, rtwdev, path, 0x1c, BIT(3));
+	if (ret)
+		rtw89_debug(rtwdev, RTW89_DBG_RFK, "[RCK] RCK timeout\n");
+
+	rck_val = rtw89_read_rf(rtwdev, path, RR_RCKC, RR_RCKC_CA);
+	rtw89_write_rf(rtwdev, path, RR_RCKC, RFREG_MASK, rck_val);
+
+	rtw89_write_rf(rtwdev, path, RR_RSV1, RFREG_MASK, rf_reg5);
+
+	rtw89_debug(rtwdev, RTW89_DBG_RFK,
+		    "[RCK] S%d RF 0x1b / 0x1c = 0x%x / 0x%x\n", path,
+		    rtw89_read_rf(rtwdev, path, RR_RCKC, RFREG_MASK),
+		    rtw89_read_rf(rtwdev, path, RR_RCKS, RFREG_MASK));
+}
+
+void rtw8192xb_rck(struct rtw89_dev *rtwdev)
+{
+	u8 path;
+
+	for (path = RF_PATH_A; path < RF_PATH_NUM_8192XB; path++)
+		_rck(rtwdev, path);
+}
+
+/* The vendor driver skips DPK with an external PA and keeps the DPD off. */
+void rtw8192xb_dpk(struct rtw89_dev *rtwdev)
+{
+	u8 path, kidx;
+
+	for (path = RF_PATH_A; path < RF_PATH_NUM_8192XB; path++)
+		for (kidx = 0; kidx < 2; kidx++)
+			rtw89_phy_write32_mask(rtwdev,
+					       R_DPD_CH0A + (path << 8) + (kidx << 2),
+					       B_DPD_MEN, 0);
+}
+
+void rtw8192xb_mcc_get_ch_info(struct rtw89_dev *rtwdev,
+			       enum rtw89_phy_idx phy_idx)
+{
+	struct rtw89_rfk_mcc_info_data *rfk_mcc = rtwdev->rfk_mcc.data;
+	struct rtw89_rfk_chan_desc desc[__RTW89_RFK_CHS_NR_V0] = {};
+	const struct rtw89_chan *chan;
+	enum rtw89_entity_mode mode;
+	u8 chan_idx;
+	u8 idx;
+
+	mode = rtw89_get_entity_mode(rtwdev);
+	switch (mode) {
+	case RTW89_ENTITY_MODE_MCC_PREPARE:
+		chan_idx = RTW89_CHANCTX_1;
+		break;
+	default:
+		chan_idx = RTW89_CHANCTX_0;
+		break;
+	}
+
+	chan = rtw89_chan_get(rtwdev, chan_idx);
+
+	for (idx = 0; idx < ARRAY_SIZE(desc); idx++) {
+		struct rtw89_rfk_chan_desc *p = &desc[idx];
+
+		p->ch = rfk_mcc->ch[idx];
+
+		p->has_band = true;
+		p->band = rfk_mcc->band[idx];
+	}
+
+	idx = rtw89_rfk_chan_lookup(rtwdev, desc, ARRAY_SIZE(desc), chan);
+
+	rfk_mcc->ch[idx] = chan->channel;
+	rfk_mcc->band[idx] = chan->band_type;
+	rfk_mcc->table_idx = idx;
+}
+
+static void _ch_setting(struct rtw89_dev *rtwdev, enum rtw89_rf_path path,
+			u8 central_ch, bool is_dav)
+{
+	u32 reg = is_dav ? RR_CFGCH : RR_CFGCH_V1;
+	u32 rf_reg18;
+	u32 lo;
+
+	rf_reg18 = rtw89_read_rf(rtwdev, path, reg, RFREG_MASK);
+	rf_reg18 &= ~(RR_CFGCH_BAND1 | RR_CFGCH_BAND0 | RR_CFGCH_CH);
+	rf_reg18 |= FIELD_PREP(RR_CFGCH_CH, central_ch);
+	rf_reg18 |= FIELD_PREP(RR_CFGCH_BAND1, CFGCH_BAND1_2G);
+	rf_reg18 |= FIELD_PREP(RR_CFGCH_BAND0, CFGCH_BAND0_2G);
+
+	/* LO setting by channel group */
+	if (central_ch <= 4)
+		lo = 0x000a0;
+	else if (central_ch <= 10)
+		lo = 0x800a2;
+	else if (central_ch <= 13)
+		lo = 0x800a4;
+	else
+		lo = 0x000a5;
+
+	rtw89_write_rf(rtwdev, path, RR_MALSEL, RFREG_MASK, lo);
+	fsleep(5);
+
+	rtw89_write_rf(rtwdev, path, reg, RFREG_MASK, rf_reg18);
+	fsleep(100);
+}
+
+static void _bw_setting(struct rtw89_dev *rtwdev, enum rtw89_rf_path path,
+			enum rtw89_bandwidth bw, bool is_dav)
+{
+	u32 reg = is_dav ? RR_CFGCH : RR_CFGCH_V1;
+	u32 rf_reg18;
+
+	rf_reg18 = rtw89_read_rf(rtwdev, path, reg, RFREG_MASK);
+	rf_reg18 &= ~RR_CFGCH_BW;
+
+	if (bw == RTW89_CHANNEL_WIDTH_40)
+		rf_reg18 |= FIELD_PREP(RR_CFGCH_BW, CFGCH_BW_40M);
+	else
+		rf_reg18 |= FIELD_PREP(RR_CFGCH_BW, CFGCH_BW_20M);
+
+	rtw89_write_rf(rtwdev, path, reg, RFREG_MASK, rf_reg18);
+}
+
+static void _set_rxbb_bw(struct rtw89_dev *rtwdev, enum rtw89_rf_path path,
+			 enum rtw89_bandwidth bw)
+{
+	rtw89_write_rf(rtwdev, path, RR_LUTWE2, RR_LUTWE2_RTXBW, 0x1);
+	rtw89_write_rf(rtwdev, path, RR_LUTWA, RR_LUTWA_M2, 0xa);
+	rtw89_write_rf(rtwdev, path, RR_LUTWD0, RR_LUTWD0_LB,
+		       bw == RTW89_CHANNEL_WIDTH_40 ? 0x13 : 0x1b);
+	rtw89_write_rf(rtwdev, path, RR_LUTWE2, RR_LUTWE2_RTXBW, 0x0);
+}
+
+void rtw8192xb_set_channel_rf(struct rtw89_dev *rtwdev,
+			      const struct rtw89_chan *chan,
+			      enum rtw89_phy_idx phy_idx)
+{
+	u8 path;
+
+	if (chan->channel > 14)
+		return;
+
+	for (path = RF_PATH_A; path < RF_PATH_NUM_8192XB; path++) {
+		_ch_setting(rtwdev, path, chan->channel, true);
+		_ch_setting(rtwdev, path, chan->channel, false);
+		_bw_setting(rtwdev, path, chan->band_width, true);
+		_bw_setting(rtwdev, path, chan->band_width, false);
+		_set_rxbb_bw(rtwdev, path, chan->band_width);
+	}
+}
