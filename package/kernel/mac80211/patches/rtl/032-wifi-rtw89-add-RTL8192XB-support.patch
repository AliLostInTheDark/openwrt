+static void rtw8192xb_set_gain_wbagc(struct rtw89_dev *rtwdev, u8 gain_band,
+				     enum rtw89_rf_path path)
+{
+	static const u32 elna_lo[] = {0x4734, 0x4aa0};
+	static const u32 elna_hi[] = {0x4738, 0x4aa4};
+	static const u32 lna_tia_lo[] = {0x4724, 0x4a78};
+	static const u32 lna_tia_hi[] = {0x4728, 0x4a7c};
+	static const u32 gs_lo[] = {0x46b4, 0x4a68};
+	static const u32 gs_hi[] = {0x46b8, 0x4a6c};
+	static const u32 g_elna[] = {0x4678, 0x475c};
+	const struct rtw89_phy_bb_gain_info *gain = &rtwdev->bb_gain.ax;
+	const u8 *lna_tia = gain->wbagc_1_2[gain_band][path];
+	u32 elna = gain->wbagc_0[gain_band][path];
+	u32 lo = 0, hi = 0;
+	int i;
+
+	rtw89_phy_write32_mask(rtwdev, elna_lo[path], GENMASK(31, 23),
+			       elna & GENMASK(8, 0));
+	rtw89_phy_write32_mask(rtwdev, elna_hi[path], GENMASK(6, 0),
+			       (elna & GENMASK(15, 9)) >> 9);
+
+	for (i = 0; i < 7; i++)
+		lo |= lna_tia[i] << (3 * i);
+	for (i = 0; i < 9; i++)
+		hi |= lna_tia[i + 7] << (3 * i);
+	rtw89_phy_write32_mask(rtwdev, lna_tia_lo[path], GENMASK(29, 9), lo);
+	rtw89_phy_write32_mask(rtwdev, lna_tia_hi[path], GENMASK(26, 0), hi);
+
+	rtw89_phy_write32(rtwdev, gs_lo[path], gain->wbagc_3[gain_band][path]);
+	rtw89_phy_write32_mask(rtwdev, gs_hi[path], GENMASK(11, 0),
+			       gain->wbagc_4[gain_band][path]);
+	rtw89_phy_write32_mask(rtwdev, g_elna[path], GENMASK(15, 0),
+			       gain->wbagc_5[gain_band][path]);
+}
