+static void rtw8192xb_set_gain_error(struct rtw89_dev *rtwdev,
+				     enum rtw89_subband subband,
+				     enum rtw89_rf_path path)
+{
+	const struct rtw89_phy_bb_gain_info *gain = &rtwdev->bb_gain.ax;
+	u8 gain_band = rtw89_subband_to_bb_gain_band(subband);
+	const struct rtw8192xb_bb_gain *g;
+	int i;
+
+	for (i = 0; i < LNA_GAIN_NUM; i++) {
+		g = &bb_gain_lna[i];
+		rtw89_phy_write32_mask(rtwdev, g->reg[path], g->mask,
+				       gain->lna_gain[gain_band][path][i]);
+		g = &bb_gain_bypass_lna[i];
+		rtw89_phy_write32_mask(rtwdev, g->reg[path], g->mask,
+				       gain->lna_gain_bypass[gain_band][path][i]);
+	}
+
+	for (i = 0; i < TIA_GAIN_NUM; i++) {
+		g = &bb_gain_tia[i];
+		rtw89_phy_write32_mask(rtwdev, g->reg[path], g->mask,
+				       gain->tia_gain[gain_band][path][i]);
+	}
+
+	if (!rtw89_rfe_has_efem(rtwdev))
+		return;
+
+	for (i = 0; i < LNA_GAIN_NUM; i++) {
+		g = &bb_gain_lna_op1db[i];
+		rtw89_phy_write32_mask(rtwdev, g->reg[path], g->mask,
+				       gain->lna_op1db[gain_band][path][i]);
+	}
+
+	for (i = 0; i < ARRAY_SIZE(bb_gain_tia_lna_op1db); i++) {
+		g = &bb_gain_tia_lna_op1db[i];
+		rtw89_phy_write32_mask(rtwdev, g->reg[path], g->mask,
+				       gain->tia_lna_op1db[gain_band][path][i]);
+	}
+
+	rtw8192xb_set_gain_wbagc(rtwdev, gain_band, path);
+}
+
+static void rtw8192xb_ctrl_ch(struct rtw89_dev *rtwdev,
+			      const struct rtw89_chan *chan,
+			      enum rtw89_phy_idx phy_idx)
+{
+	u8 sco;
+	u16 central_freq = chan->freq;
+	u8 central_ch = chan->channel;
+	u8 band = chan->band_type;
+	u8 subband = chan->subband_type;
+	bool is_2g = band == RTW89_BAND_2G;
+	u8 chan_idx;
+
+	if (!central_freq) {
+		rtw89_warn(rtwdev, "Invalid central_freq\n");
+		return;
+	}
+
+	rtw89_phy_write32_mask(rtwdev, R_PATH0_BAND_SEL_V1,
+			       B_PATH0_BAND_SEL_MSK_V1, is_2g);
+	rtw89_phy_write32_mask(rtwdev, R_PATH1_BAND_SEL_V1,
+			       B_PATH1_BAND_SEL_MSK_V1, is_2g);
+
+	/* SCO compensate FC setting */
+	rtw89_phy_write32_mask(rtwdev, R_FC0_V1, B_FC0_MSK_V1, central_freq);
+	/* round_up((1/fc0)*pow(2,18)) */
+	sco = DIV_ROUND_CLOSEST(1 << 18, central_freq);
+	rtw89_phy_write32_mask(rtwdev, R_FC0_BW, B_FC0_BW_INV, sco);
+
+	rtw8192xb_set_gain_error(rtwdev, subband, RF_PATH_A);
+	rtw8192xb_set_gain_error(rtwdev, subband, RF_PATH_B);
+	rtw8852cx_set_gain_offset(rtwdev, chan, phy_idx, RF_PATH_A);
+	rtw8852cx_set_gain_offset(rtwdev, chan, phy_idx, RF_PATH_B);
+
+	/* CCK parameters */
+	if (band == RTW89_BAND_2G) {
+		if (central_ch == 14) {
+			rtw89_phy_write32_mask(rtwdev, R_PCOEFF0_V1,
+					       B_PCOEFF01_MSK_V1, 0x3b13ff);
+			rtw89_phy_write32_mask(rtwdev, R_PCOEFF2_V1,
+					       B_PCOEFF23_MSK_V1, 0x1c42de);
+			rtw89_phy_write32_mask(rtwdev, R_PCOEFF4_V1,
+					       B_PCOEFF45_MSK_V1, 0xfdb0ad);
+			rtw89_phy_write32_mask(rtwdev, R_PCOEFF6_V1,
+					       B_PCOEFF67_MSK_V1, 0xf60f6e);
+			rtw89_phy_write32_mask(rtwdev, R_PCOEFF8_V1,
+					       B_PCOEFF89_MSK_V1, 0xfd8f92);
+			rtw89_phy_write32_mask(rtwdev, R_PCOEFFA_V1,
+					       B_PCOEFFAB_MSK_V1, 0x2d011);
+			rtw89_phy_write32_mask(rtwdev, R_PCOEFFC_V1,
+					       B_PCOEFFCD_MSK_V1, 0x1c02c);
+			rtw89_phy_write32_mask(rtwdev, R_PCOEFFE_V1,
+					       B_PCOEFFEF_MSK_V1, 0xfff00a);
+		} else {
+			rtw89_phy_write32_mask(rtwdev, R_PCOEFF0_V1,
+					       B_PCOEFF01_MSK_V1, 0x3d23ff);
+			rtw89_phy_write32_mask(rtwdev, R_PCOEFF2_V1,
+					       B_PCOEFF23_MSK_V1, 0x29b354);
+			rtw89_phy_write32_mask(rtwdev, R_PCOEFF4_V1,
+					       B_PCOEFF45_MSK_V1, 0xfc1c8);
+			rtw89_phy_write32_mask(rtwdev, R_PCOEFF6_V1,
+					       B_PCOEFF67_MSK_V1, 0xfdb053);
+			rtw89_phy_write32_mask(rtwdev, R_PCOEFF8_V1,
+					       B_PCOEFF89_MSK_V1, 0xf86f9a);
+			rtw89_phy_write32_mask(rtwdev, R_PCOEFFA_V1,
+					       B_PCOEFFAB_MSK_V1, 0xfaef92);
+			rtw89_phy_write32_mask(rtwdev, R_PCOEFFC_V1,
+					       B_PCOEFFCD_MSK_V1, 0xfe5fcc);
+			rtw89_phy_write32_mask(rtwdev, R_PCOEFFE_V1,
+					       B_PCOEFFEF_MSK_V1, 0xffdff5);
+		}
+	}
+
+	chan_idx = rtw89_encode_chan_idx(rtwdev, chan->primary_channel, band);
+	rtw89_phy_write32_idx(rtwdev, R_MAC_PIN_SEL, B_CH_IDX_SEG0, chan_idx, phy_idx);
+}
+
+struct rtw8192xb_adc_cfg {
+	u8 td;
+	u8 sample_td;
+	u8 op5_bw;
+	u8 rck_ofst;
+	u8 idac2;
+	u8 idac2_1;
+	u8 rck_rst;
+	u8 rst_cycle;
+};
+
+/* ADC settings of FT-tested dies, by the ADC timing code in efuse.
+ * A zero rst_cycle depends on the front end.
+ */
+static const struct rtw8192xb_adc_cfg rtw8192xb_adc_cfgs[] = {
+	{0x19, 2, 0x4, 0xf, 8, 2, 0xa, 3},
+	{0x11, 2, 0x5, 0xf, 8, 2, 0xa, 3},
+	{0x09, 2, 0x3, 0xf, 8, 2, 0xa, 3},
+	{0x1b, 3, 0xc, 0xc, 8, 2, 0x9, 0},
+	{0x1a, 3, 0xe, 0xf, 5, 0, 0x9, 0},
+	{0x12, 3, 0xd, 0xf, 5, 0, 0x9, 0},
+	{0x0a, 3, 0xc, 0xf, 5, 0, 0x9, 0},
+};
+
+#define RTW8192XB_ADC_FT_BLANK 0xff
+#define RTW8192XB_ADC_FT_PASS 0xcc
+#define RTW8192XB_ADC_FT_PASS_V1 0xfc
+
+static const struct rtw8192xb_adc_cfg *rtw8192xb_get_adc_cfg(struct rtw89_dev *rtwdev)
+{
+	static const struct rtw8192xb_adc_cfg dflt = {.sample_td = 3, .op5_bw = 0xc,
+						      .rck_ofst = 0xc};
+	static const struct rtw8192xb_adc_cfg untested = {.sample_td = 2, .op5_bw = 0xf,
+							  .rck_ofst = 0x9};
+	const struct rtw89_efuse *efuse = &rtwdev->efuse;
+	u8 td = efuse->adc_td & 0x1f;
+	int i;
+
+	if (efuse->adc_ft == RTW8192XB_ADC_FT_BLANK)
+		return &dflt;
+
+	if (efuse->adc_ft != RTW8192XB_ADC_FT_PASS &&
+	    efuse->adc_ft != RTW8192XB_ADC_FT_PASS_V1)
+		return &untested;
+
+	for (i = 0; i < ARRAY_SIZE(rtw8192xb_adc_cfgs); i++)
+		if (rtw8192xb_adc_cfgs[i].td == td)
+			return &rtw8192xb_adc_cfgs[i];
+
+	return &dflt;
+}
+
+static void rtw8192xb_bw_setting(struct rtw89_dev *rtwdev, u8 bw, u8 path)
+{
+	static const u32 rck_ofst[2] = {0xc0c4, 0xc1c4};
+	static const u32 sample_td[2] = {R_PATH0_SAMPL_DLY_T_V1, R_PATH1_SAMPL_DLY_T_V1};
+	static const u32 op5_bw[2] = {R_PATH0_BW_SEL_V1, R_PATH1_BW_SEL_V1};
+	static const u32 wbadc_sel[2] = {0xc0e4, 0xc1e4};
+	static const u32 rck_rst[2] = {0xc0e8, 0xc1e8};
+	static const u32 adc_sel[2] = {0xc0ec, 0xc1ec};
+	static const u32 adc_clk[2] = {0x12a0, 0x32a0};
+	const struct rtw8192xb_adc_cfg *cfg = rtw8192xb_get_adc_cfg(rtwdev);
+	u8 decim;
+
+	switch (bw) {
+	case RTW89_CHANNEL_WIDTH_5:
+		rtw89_phy_write32_mask(rtwdev, wbadc_sel[path], 0x30, 0x0);
+		decim = 0x1;
+		break;
+	case RTW89_CHANNEL_WIDTH_10:
+		rtw89_phy_write32_mask(rtwdev, wbadc_sel[path], 0x30, 0x1);
+		decim = rtwdev->hal.cv == CHIP_CAV ? 0x2 : 0x1;
+		break;
+	case RTW89_CHANNEL_WIDTH_20:
+	case RTW89_CHANNEL_WIDTH_40:
+		rtw89_phy_write32_mask(rtwdev, wbadc_sel[path], 0x30, 0x2);
+		decim = rtwdev->hal.cv == CHIP_CAV ? 0x0 : 0x2;
+		break;
+	default:
+		rtw89_warn(rtwdev, "Fail to set ADC\n");
+		return;
+	}
+
+	if (cfg->idac2) {
+		rtw89_phy_write32_mask(rtwdev, sample_td[path], 0x780, cfg->idac2);
+		rtw89_phy_write32_mask(rtwdev, sample_td[path], 0x7800, cfg->idac2_1);
+	}
+	rtw89_phy_write32_mask(rtwdev, sample_td[path], B_PATH0_SAMPL_DLY_T_MSK_V1,
+			       cfg->sample_td);
+	rtw89_phy_write32_mask(rtwdev, op5_bw[path], B_PATH0_BW_SEL_MSK_V1, cfg->op5_bw);
+	rtw89_phy_write32_mask(rtwdev, rck_ofst[path], 0x3e0000, cfg->rck_ofst);
+	if (cfg->rck_rst)
+		rtw89_phy_write32_mask(rtwdev, rck_rst[path], 0xffff0000,
+				       cfg->rck_rst);
+	if (cfg->rst_cycle)
+		rtw89_phy_write32_mask(rtwdev, adc_sel[path], 0xff0000,
+				       cfg->rst_cycle);
+	else if (cfg->td)
+		rtw89_phy_write32_mask(rtwdev, adc_sel[path], 0xff0000,
+				       rtw89_rfe_has_efem(rtwdev) ? 0x2 : 0x3);
+
+	if (rtwdev->hal.cv == CHIP_CAV) {
+		rtw89_phy_write32_mask(rtwdev, adc_clk[path], 0xff800000, 0x49);
+	} else if (rtwdev->hal.cv == CHIP_CBV) {
+		rtw89_phy_write32_mask(rtwdev, adc_clk[path], 0xff800000, 0x92);
+		rtw89_phy_write32_mask(rtwdev, 0xc000, BIT(18), 0);
+	} else {
+		return;
+	}
+	rtw89_phy_write32_mask(rtwdev, adc_sel[path], 0x6000, decim);
+}
+
+static void
+rtw8192xb_ctrl_bw(struct rtw89_dev *rtwdev, u8 pri_ch, u8 bw,
+		  enum rtw89_phy_idx phy_idx)
+{
+	bool bw40 = bw == RTW89_CHANNEL_WIDTH_40;
+	u8 mod_sbw = 0;
+
+	switch (bw) {
+	case RTW89_CHANNEL_WIDTH_5:
+		mod_sbw = 0x1;
+		break;
+	case RTW89_CHANNEL_WIDTH_10:
+		mod_sbw = 0x2;
+		break;
+	case RTW89_CHANNEL_WIDTH_20:
+	case RTW89_CHANNEL_WIDTH_40:
+		break;
+	default:
+		rtw89_warn(rtwdev, "Fail to switch bw (bw:%d, pri ch:%d)\n", bw,
+			   pri_ch);
+		return;
+	}
+
+	rtw89_phy_write32_mask(rtwdev, R_FC0_BW, B_FC0_BW_SET, bw40);
+	rtw89_phy_write32_mask(rtwdev, R_CHBW_MOD, B_CHBW_MOD_SBW, mod_sbw);
+	rtw89_phy_write32_mask(rtwdev, R_CHBW_MOD, B_CHBW_MOD_PRICH,
+			       bw40 ? pri_ch : 0);
+	rtw89_phy_write32_mask(rtwdev, R_PATH0_FRC_FIR_TYPE_V1,
+			       B_PATH0_FIR_TYPE_INIT_V1, bw40);
+	rtw89_phy_write32_mask(rtwdev, R_PATH1_FRC_FIR_TYPE_V1,
+			       B_PATH1_FIR_TYPE_INIT_V1, bw40);
+
+	rtw89_phy_write32_mask(rtwdev, R_RX_BW40_2XFFT_EN_V1,
+			       B_RX_BW40_2XFFT_EN_MSK_V1, bw40);
+	rtw89_phy_write32_mask(rtwdev, R_T2F_GI_COMB, B_T2F_GI_COMB_EN, bw40);
+	rtw89_phy_write32_set(rtwdev, R_TX_CREST_FCTR, B_TX_CREST_FCTR_EN);
+
+	rtw8192xb_bw_setting(rtwdev, bw, RF_PATH_A);
+	rtw8192xb_bw_setting(rtwdev, bw, RF_PATH_B);
+
+	rtw8852cx_edcca_per20_bitmap_sifs(rtwdev, bw, phy_idx);
+}
+
+static void rtw8192xb_bb_reset_all(struct rtw89_dev *rtwdev,
+				   enum rtw89_phy_idx phy_idx)
+{
+	/*HW SI reset*/
+	rtw89_phy_write32_mask(rtwdev, R_S0_HW_SI_DIS, B_S0_HW_SI_DIS_W_R_TRIG,
+			       0x7);
+	rtw89_phy_write32_mask(rtwdev, R_S1_HW_SI_DIS, B_S1_HW_SI_DIS_W_R_TRIG,
+			       0x7);
+
+	udelay(1);
+
+	rtw89_phy_write32_idx(rtwdev, R_RSTB_ASYNC, B_RSTB_ASYNC_ALL, 1,
+			      phy_idx);
+	rtw89_phy_write32_idx(rtwdev, R_RSTB_ASYNC, B_RSTB_ASYNC_ALL, 0,
+			      phy_idx);
+	/*HW SI reset*/
+	rtw89_phy_write32_mask(rtwdev, R_S0_HW_SI_DIS, B_S0_HW_SI_DIS_W_R_TRIG,
+			       0x0);
+	rtw89_phy_write32_mask(rtwdev, R_S1_HW_SI_DIS, B_S1_HW_SI_DIS_W_R_TRIG,
+			       0x0);
+
+	rtw89_phy_write32_idx(rtwdev, R_RSTB_ASYNC, B_RSTB_ASYNC_ALL, 1,
+			      phy_idx);
+}
+
+static void rtw8192xb_bb_reset_en(struct rtw89_dev *rtwdev,
+				  enum rtw89_band band,
+				  enum rtw89_phy_idx phy_idx, bool en)
+{
+	if (en) {
+		rtw89_phy_write32_idx(rtwdev, R_S0_HW_SI_DIS,
+				      B_S0_HW_SI_DIS_W_R_TRIG, 0x0, phy_idx);
+		rtw89_phy_write32_idx(rtwdev, R_S1_HW_SI_DIS,
+				      B_S1_HW_SI_DIS_W_R_TRIG, 0x0, phy_idx);
+		rtw89_phy_write32_idx(rtwdev, R_RSTB_ASYNC, B_RSTB_ASYNC_ALL, 1,
+				      phy_idx);
+		if (band == RTW89_BAND_2G)
+			rtw89_phy_write32_mask(rtwdev, R_RXCCA, B_RXCCA_DIS, 0x0);
+		rtw89_phy_write32_mask(rtwdev, R_PD_CTRL, B_PD_HIT_DIS, 0x0);
+	} else {
+		rtw89_phy_write32_mask(rtwdev, R_RXCCA, B_RXCCA_DIS, 0x1);
+		rtw89_phy_write32_mask(rtwdev, R_PD_CTRL, B_PD_HIT_DIS, 0x1);
+		rtw89_phy_write32_idx(rtwdev, R_S0_HW_SI_DIS,
+				      B_S0_HW_SI_DIS_W_R_TRIG, 0x7, phy_idx);
+		rtw89_phy_write32_idx(rtwdev, R_S1_HW_SI_DIS,
+				      B_S1_HW_SI_DIS_W_R_TRIG, 0x7, phy_idx);
+		fsleep(1);
+		rtw89_phy_write32_idx(rtwdev, R_RSTB_ASYNC, B_RSTB_ASYNC_ALL, 0,
+				      phy_idx);
+	}
+}
+
+static void rtw8192xb_tssi_hold(struct rtw89_dev *rtwdev, bool hold)
+{
+	rtw89_phy_write32_mask(rtwdev, R_P0_TXPW_RSTB, B_P0_TXPW_RSTB_MANON, hold);
+	rtw89_phy_write32_mask(rtwdev, R_P0_TSSI_TRK, B_P0_TSSI_TRK_EN, hold);
+	rtw89_phy_write32_mask(rtwdev, R_P1_TXPW_RSTB, B_P1_TXPW_RSTB_MANON, hold);
+	rtw89_phy_write32_mask(rtwdev, R_P1_TSSI_TRK, B_P1_TSSI_TRK_EN, hold);
+}
+
+static void rtw8192xb_bb_reset(struct rtw89_dev *rtwdev,
+			       enum rtw89_phy_idx phy_idx)
+{
+	rtw8192xb_tssi_hold(rtwdev, true);
+	rtw8192xb_bb_reset_all(rtwdev, phy_idx);
+	rtw8192xb_tssi_hold(rtwdev, false);
+}
+
+static void rtw8192xb_bb_gpio_init(struct rtw89_dev *rtwdev)
+{
+	static const u32 cr_bases[] = {0x5800, 0x7800};
+	u8 pape, trsw = 0, lnaon;
+	enum rtw89_rf_path path;
+	u32 addr;
+	u8 i;
+
+	for (i = 0; i < ARRAY_SIZE(cr_bases); i++) {
+		addr = cr_bases[i];
+		rtw89_phy_write32_set(rtwdev, (addr | 0x68), B_P0_TRSW_A);
+		rtw89_phy_write32_clr(rtwdev, (addr | 0x68), B_P0_TRSW_X);
+		rtw89_phy_write32_clr(rtwdev, (addr | 0x68), B_P0_TRSW_SO_A2);
+		rtw89_phy_write32(rtwdev, (addr | 0x80), 0x77777777);
+		rtw89_phy_write32(rtwdev, (addr | 0x84), 0x77777777);
+		rtw89_phy_write32_set(rtwdev, (addr | 0x94), BIT(24) | BIT(25));
+	}
+
+	rtw89_phy_write32(rtwdev, R_RFE_E_A2, 0xffffffff);
+	rtw89_phy_write32(rtwdev, R_RFE_O_SEL_A2, 0);
+	rtw89_phy_write32(rtwdev, R_RFE_SEL0_A2, 0);
+	rtw89_phy_write32(rtwdev, R_RFE_SEL32_A2, 0);
+
+	for (path = RF_PATH_A; path <= RF_PATH_B; path++) {
+		rtw8852cx_bb_gpio_trsw(rtwdev, path, 0, 0, 0, 0, 1);
+		rtw8852cx_bb_gpio_trsw(rtwdev, path, 0, 0, 1, 1, 0);
+		rtw8852cx_bb_gpio_trsw(rtwdev, path, 0, 1, 0, 1, 0);
+		rtw8852cx_bb_gpio_trsw(rtwdev, path, 0, 1, 1, 1, 0);
+		rtw8852cx_bb_gpio_trsw(rtwdev, path, 1, 0, 0, 0, 1);
+		rtw8852cx_bb_gpio_trsw(rtwdev, path, 1, 0, 1, 1, 0);
+		rtw8852cx_bb_gpio_trsw(rtwdev, path, 1, 1, 0, 1, 0);
+		rtw8852cx_bb_gpio_trsw(rtwdev, path, 1, 1, 1, 1, 0);
+	}
+
+	switch (rtwdev->efuse.rfe_type) {
+	case 51:
+	case 52:
+		pape = 0x4;
+		lnaon = 0x8;
+		break;
+	case 53:
+	case 54:
+	case 94:
+		pape = 0x4;
+		trsw = 0x6;
+		lnaon = 0xa;
+		break;
+	case 55:
+	case 56:
+		pape = 0x14;
+		lnaon = 0x18;
+		break;
+	default:
+		return;
+	}
+
+	for (path = RF_PATH_A; path <= RF_PATH_B; path++) {
+		rtw8852cx_bb_gpio_rfm(rtwdev, path, PAPE_RFM, 0, 0, 0, pape);
+		if (trsw)
+			rtw8852cx_bb_gpio_rfm(rtwdev, path, TRSW_RFM, 0, 0, 0, trsw);
+		rtw8852cx_bb_gpio_rfm(rtwdev, path, LNAON_RFM, 0, 0, 0, lnaon);
+	}
+}
+
+static void rtw8192xb_rfe_gpio(struct rtw89_dev *rtwdev)
+{
+	switch (rtwdev->efuse.rfe_type) {
+	case 51:
+	case 52:
+		rtw8852cx_efem_gpio(rtwdev, 11, RF_PATH_A, false, RFE_CTRL_PAPE);
+		rtw8852cx_efem_gpio(rtwdev, 6, RF_PATH_A, false, RFE_CTRL_LNAON);
+		rtw8852cx_efem_gpio(rtwdev, 1, RF_PATH_B, false, RFE_CTRL_PAPE);
+		rtw8852cx_efem_gpio(rtwdev, 3, RF_PATH_B, false, RFE_CTRL_LNAON);
+		break;
+	case 53:
+	case 54:
+	case 94:
+		rtw8852cx_efem_gpio(rtwdev, 11, RF_PATH_A, false, RFE_CTRL_PAPE);
+		rtw8852cx_efem_gpio(rtwdev, 7, RF_PATH_A, true, RFE_CTRL_TRSW);
+		rtw8852cx_efem_gpio(rtwdev, 6, RF_PATH_A, true, RFE_CTRL_LNAON);
+		rtw8852cx_efem_gpio(rtwdev, 1, RF_PATH_B, false, RFE_CTRL_PAPE);
+		rtw8852cx_efem_gpio(rtwdev, 2, RF_PATH_B, true, RFE_CTRL_TRSW);
+		rtw8852cx_efem_gpio(rtwdev, 3, RF_PATH_B, true, RFE_CTRL_LNAON);
+		break;
+	}
+
+	if (rtw89_rfe_has_efem(rtwdev))
+		rtw8852cx_efem_gpio(rtwdev, 12, RF_PATH_A, true, RFE_CTRL_ZERO);
+}
