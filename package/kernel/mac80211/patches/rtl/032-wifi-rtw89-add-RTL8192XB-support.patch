+static void rtw8192xb_bb_sethw(struct rtw89_dev *rtwdev)
+{
+	struct rtw89_phy_efuse_gain *gain = &rtwdev->efuse_gain;
+
+	/* T2R time: 0xf * 0.4 us + 0x9 * 0.4 us */
+	rtw89_phy_write32_mask(rtwdev, R_TIME_TX_TO_RX, B_TIME_TX_TO_RX_END, 0xf);
+	rtw89_phy_write32_mask(rtwdev, R_TIME_CCA_MASK, B_TIME_CCA_MASK_T2R, 0x9);
+
+	rtw8852cx_bb_macid_ctrl_init(rtwdev, RTW89_PHY_0);
+	rtw8192xb_bb_gpio_init(rtwdev);
+
+	/* read these registers after loading BB parameters */
+	gain->offset_base[RTW89_PHY_0] =
+		rtw89_phy_read32_mask(rtwdev, R_RPL_BIAS_COMP, B_RPL_BIAS_COMP_MASK);
+}
