+#define RTW8192XB_ADC_TD_ADDR 0x5af
+#define RTW8192XB_ADC_FT_ADDR 0x5e3
+#define RTW8192XB_PWR_K_CHK_ADDR 0x5e9
+#define RTW8192XB_PWR_K_CHK_VALUE 0xaa
+#define RTW8192XB_PROCESS_CHK_ADDR 0x5ea
+#define RTW8192XB_PROCESS_CHK_T 0xff
+
+static int rtw8192xb_read_phycap(struct rtw89_dev *rtwdev, u8 *phycap_map)
+{
+	struct rtw89_efuse *efuse = &rtwdev->efuse;
+	u32 addr = rtwdev->chip->phycap_addr;
+
+	rtw8852cx_phycap_parsing_tssi(rtwdev, phycap_map);
+	rtw8852cx_phycap_parsing_thermal_trim(rtwdev, phycap_map);
+	rtw8852cx_phycap_parsing_pa_bias_trim(rtwdev, phycap_map);
+
+	efuse->adc_td = phycap_map[RTW8192XB_ADC_TD_ADDR - addr];
+	efuse->adc_ft = phycap_map[RTW8192XB_ADC_FT_ADDR - addr];
+
+	/* the core voltage needs trimming only on a T process die without
+	 * power calibration
+	 */
+	if (phycap_map[RTW8192XB_PWR_K_CHK_ADDR - addr] == RTW8192XB_PWR_K_CHK_VALUE ||
+	    phycap_map[RTW8192XB_PROCESS_CHK_ADDR - addr] != RTW8192XB_PROCESS_CHK_T)
+		efuse->power_k_valid = true;
+
+	return 0;
+}
