+static void __rtw8852cx_set_txpwr_ctrl(struct rtw89_dev *rtwdev,
+				       enum rtw89_phy_idx phy_idx)
+{
+	rtw8852cx_set_txpwr_ref(rtwdev, phy_idx, 0);
+}
