+static void __rtw8852cx_set_txpwr_diff(struct rtw89_dev *rtwdev,
+				       const struct rtw89_chan *chan,
+				       enum rtw89_phy_idx phy_idx)
+{
+	s16 pwr_ofst;
+
+	pwr_ofst = rtw89_phy_ant_gain_pwr_offset(rtwdev, chan);
+	rtw8852cx_set_txpwr_ref(rtwdev, phy_idx, pwr_ofst);
+}
