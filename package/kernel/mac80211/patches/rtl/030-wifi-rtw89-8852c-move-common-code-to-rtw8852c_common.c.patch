+	.set_txpwr_sar_diff = __rtw8852cx_set_txpwr_sar_diff,
+	.set_txpwr_ctrl = __rtw8852cx_set_txpwr_ctrl,
+	.ctrl_nbtg_bt_tx = __rtw8852cx_ctrl_nbtg_bt_tx,
+	.btc_set_rfe = __rtw8852cx_btc_set_rfe,
+	.ctrl_btg_bt_rx = __rtw8852cx_ctrl_btg_bt_rx,
+	.btc_init_cfg = __rtw8852cx_btc_init_cfg,
+	.btc_set_wl_pri = __rtw8852cx_btc_set_wl_pri,
+	.btc_get_bt_rssi = __rtw8852cx_btc_get_bt_rssi,
+	.btc_update_bt_cnt = __rtw8852cx_btc_update_bt_cnt,
+	.btc_wl_s1_standby = __rtw8852cx_btc_wl_s1_standby,
+	.btc_set_wl_rx_gain = __rtw8852cx_btc_set_wl_rx_gain,
+	.query_ppdu = __rtw8852cx_query_ppdu,
+	.mac_enable_bb_rf = __rtw8852cx_mac_enable_bb_rf,
+	.mac_disable_bb_rf = __rtw8852cx_mac_disable_bb_rf,
+};
