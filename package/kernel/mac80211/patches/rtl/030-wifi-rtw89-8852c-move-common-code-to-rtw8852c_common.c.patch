+static inline bool rtw8852cx_decode_efuse_gain(u8 data, s8 *high, s8 *low)
+{
+	if (high)
+		*high = FIELD_GET_SIGNED(GENMASK(7, 4), data);
+	if (low)
+		*low = FIELD_GET_SIGNED(GENMASK(3, 0), data);
+
+	return data != 0xff;
+}
