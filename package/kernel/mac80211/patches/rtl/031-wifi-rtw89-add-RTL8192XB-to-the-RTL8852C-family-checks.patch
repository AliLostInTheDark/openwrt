+static inline bool rtw89_is_rtl8852cx(struct rtw89_dev *rtwdev)
+{
+	enum rtw89_core_chip_id chip_id = rtwdev->chip->chip_id;
+
+	return chip_id == RTL8852C || chip_id == RTL8192XB;
