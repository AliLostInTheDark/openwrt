From: Ifran Ali <khanu.i.i.k.2000@gmail.com>
Subject: [PATCH] wifi: rtw89: 8852c: set the ADC up per bandwidth like the vendor

From 20 to 160 MHz the vendor driver also programs IDAC2, the RCK
offset and reset count, the RX ADC clock, the ADC reset cycle (2 with
an external FEM at 20/40 MHz) and the AGC restart threshold for the
bandwidth, and uses ADC filter bandwidth 8 at 80 MHz and sample delay
2 with filter bandwidth 4 at 160 MHz. Do the same, and stop the RF
bandwidth setup from writing those two ADC fields again with the old
values; the vendor sets them in the BB ADC configuration only.

Signed-off-by: Ifran Ali <khanu.i.i.k.2000@gmail.com>
--- a/drivers/net/wireless/realtek/rtw89/rtw8852c.c
+++ b/drivers/net/wireless/realtek/rtw89/rtw8852c.c
@@ -779,26 +779,53 @@ static void rtw8852c_bw_setting(struct rtw89_dev *rtwdev, u8 bw, u8 path)
 {
 	static const u32 adc_sel[2] = {0xC0EC, 0xC1EC};
 	static const u32 wbadc_sel[2] = {0xC0E4, 0xC1E4};
+	static const u32 idac2[2] = {0xC0D4, 0xC1D4};
+	static const u32 rck_ofst[2] = {0xC0C4, 0xC1C4};
+	static const u32 rck_rst[2] = {0xC0E8, 0xC1E8};
+	static const u32 rx_adc_clk[2] = {0x12A0, 0x32A0};
+	static const u32 agc_th[2] = {0x4BE8, 0x4CAC};
+	static const u32 agc_th_bw[2] = {0x4BE4, 0x4CA8};
+	u32 idac2_1 = 0x2, rck = 0x0, rst = 0x3;
+	u32 th_mask;
 
 	switch (bw) {
 	case RTW89_CHANNEL_WIDTH_5:
 		rtw89_phy_write32_mask(rtwdev, adc_sel[path], 0x6000, 0x1);
 		rtw89_phy_write32_mask(rtwdev, wbadc_sel[path], 0x30, 0x0);
-		break;
+		return;
 	case RTW89_CHANNEL_WIDTH_10:
 		rtw89_phy_write32_mask(rtwdev, adc_sel[path], 0x6000, 0x2);
 		rtw89_phy_write32_mask(rtwdev, wbadc_sel[path], 0x30, 0x1);
-		break;
+		return;
 	case RTW89_CHANNEL_WIDTH_20:
 	case RTW89_CHANNEL_WIDTH_40:
+		if (rtw89_rfe_has_efem(rtwdev))
+			rst = 0x2;
+		th_mask = bw == RTW89_CHANNEL_WIDTH_40 ? 0x7800000 : 0x780000;
+		break;
 	case RTW89_CHANNEL_WIDTH_80:
+		th_mask = 0x78000000;
+		break;
 	case RTW89_CHANNEL_WIDTH_160:
-		rtw89_phy_write32_mask(rtwdev, adc_sel[path], 0x6000, 0x0);
-		rtw89_phy_write32_mask(rtwdev, wbadc_sel[path], 0x30, 0x2);
+		idac2_1 = 0x0;
+		rck = 0x6;
+		th_mask = 0x78000;
 		break;
 	default:
 		rtw89_warn(rtwdev, "Fail to set ADC\n");
+		return;
 	}
+
+	rtw89_phy_write32_mask(rtwdev, adc_sel[path], 0x6000, 0x0);
+	rtw89_phy_write32_mask(rtwdev, wbadc_sel[path], 0x30, 0x2);
+	rtw89_phy_write32_mask(rtwdev, idac2[path], 0x780, 0x8);
+	rtw89_phy_write32_mask(rtwdev, idac2[path], 0x7800, idac2_1);
+	rtw89_phy_write32_mask(rtwdev, rck_ofst[path], 0x3e0000, rck);
+	rtw89_phy_write32_mask(rtwdev, rck_rst[path], 0xffff0000, 0x9);
+	rtw89_phy_write32_mask(rtwdev, rx_adc_clk[path], 0xff800000, 0x49);
+	rtw89_phy_write32_mask(rtwdev, adc_sel[path], 0xff0000, rst);
+	rtw89_phy_write32_mask(rtwdev, agc_th[path], 0xf,
+			       rtw89_phy_read32_mask(rtwdev, agc_th_bw[path], th_mask));
 }
 
 static void
@@ -862,9 +889,9 @@ rtw8852c_ctrl_bw(struct rtw89_dev *rtwdev, u8 pri_ch, u8 bw,
 		rtw89_phy_write32_mask(rtwdev, R_PATH1_SAMPL_DLY_T_V1,
 				       B_PATH1_SAMPL_DLY_T_MSK_V1, 0x2);
 		rtw89_phy_write32_mask(rtwdev, R_PATH0_BW_SEL_V1,
-				       B_PATH0_BW_SEL_MSK_V1, 0xd);
+				       B_PATH0_BW_SEL_MSK_V1, 0x8);
 		rtw89_phy_write32_mask(rtwdev, R_PATH1_BW_SEL_V1,
-				       B_PATH1_BW_SEL_MSK_V1, 0xd);
+				       B_PATH1_BW_SEL_MSK_V1, 0x8);
 		break;
 	case RTW89_CHANNEL_WIDTH_160:
 		rtw89_phy_write32_idx(rtwdev, R_FC0_BW, B_FC0_BW_SET, 0x3,
@@ -875,13 +902,13 @@ rtw8852c_ctrl_bw(struct rtw89_dev *rtwdev, u8 pri_ch, u8 bw,
 				      pri_ch,
 				      phy_idx);
 		rtw89_phy_write32_mask(rtwdev, R_PATH0_SAMPL_DLY_T_V1,
-				       B_PATH0_SAMPL_DLY_T_MSK_V1, 0x1);
+				       B_PATH0_SAMPL_DLY_T_MSK_V1, 0x2);
 		rtw89_phy_write32_mask(rtwdev, R_PATH1_SAMPL_DLY_T_V1,
-				       B_PATH1_SAMPL_DLY_T_MSK_V1, 0x1);
+				       B_PATH1_SAMPL_DLY_T_MSK_V1, 0x2);
 		rtw89_phy_write32_mask(rtwdev, R_PATH0_BW_SEL_V1,
-				       B_PATH0_BW_SEL_MSK_V1, 0xb);
+				       B_PATH0_BW_SEL_MSK_V1, 0x4);
 		rtw89_phy_write32_mask(rtwdev, R_PATH1_BW_SEL_V1,
-				       B_PATH1_BW_SEL_MSK_V1, 0xb);
+				       B_PATH1_BW_SEL_MSK_V1, 0x4);
 		break;
 	default:
 		rtw89_warn(rtwdev, "Fail to switch bw (bw:%d, pri ch:%d)\n", bw,
--- a/drivers/net/wireless/realtek/rtw89/rtw8852c_rfk.c
+++ b/drivers/net/wireless/realtek/rtw89/rtw8852c_rfk.c
@@ -3868,23 +3868,15 @@ static void _bw_setting(struct rtw89_dev *rtwdev, enum rtw89_rf_path path,
 	case RTW89_CHANNEL_WIDTH_10:
 	case RTW89_CHANNEL_WIDTH_20:
 		rf_reg18 |= FIELD_PREP(RR_CFGCH_BW, CFGCH_BW_20M);
-		rtw89_phy_write32_mask(rtwdev, R_P0_CFCH_BW0 | (path << 8), B_P0_CFCH_BW0, 0x3);
-		rtw89_phy_write32_mask(rtwdev, R_P0_CFCH_BW1 | (path << 8), B_P0_CFCH_BW1, 0xf);
 		break;
 	case RTW89_CHANNEL_WIDTH_40:
 		rf_reg18 |= FIELD_PREP(RR_CFGCH_BW, CFGCH_BW_40M);
-		rtw89_phy_write32_mask(rtwdev, R_P0_CFCH_BW0 | (path << 8), B_P0_CFCH_BW0, 0x3);
-		rtw89_phy_write32_mask(rtwdev, R_P0_CFCH_BW1 | (path << 8), B_P0_CFCH_BW1, 0xf);
 		break;
 	case RTW89_CHANNEL_WIDTH_80:
 		rf_reg18 |= FIELD_PREP(RR_CFGCH_BW, CFGCH_BW_80M);
-		rtw89_phy_write32_mask(rtwdev, R_P0_CFCH_BW0 | (path << 8), B_P0_CFCH_BW0, 0x2);
-		rtw89_phy_write32_mask(rtwdev, R_P0_CFCH_BW1 | (path << 8), B_P0_CFCH_BW1, 0xd);
 		break;
 	case RTW89_CHANNEL_WIDTH_160:
 		rf_reg18 |= FIELD_PREP(RR_CFGCH_BW, CFGCH_BW_160M);
-		rtw89_phy_write32_mask(rtwdev, R_P0_CFCH_BW0 | (path << 8), B_P0_CFCH_BW0, 0x1);
-		rtw89_phy_write32_mask(rtwdev, R_P0_CFCH_BW1 | (path << 8), B_P0_CFCH_BW1, 0xb);
 		break;
 	default:
 		break;
