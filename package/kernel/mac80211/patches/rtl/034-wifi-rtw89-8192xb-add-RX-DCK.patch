From: Ifran Ali <khanu.i.i.k.2000@gmail.com>
Subject: [PATCH] wifi: rtw89: 8192xb: add RX DCK

Calibrate the RX DC offset at init and on every channel switch. Unlike
the RTL8852C, Realtek's rtk_wifi6_ap driver runs it in AFE mode on this
chip: the ADC is fed from the RXBB with its clock forced to 1920 MHz,
and the KIP measures the offset in RX mode and then in DPK mode. The ADC
and KIP settings are restored afterwards.

Signed-off-by: Ifran Ali <khanu.i.i.k.2000@gmail.com>
---
--- a/drivers/net/wireless/realtek/rtw89/rtw8192xb.c
+++ b/drivers/net/wireless/realtek/rtw89/rtw8192xb.c
@@ -1046,12 +1046,14 @@ static void rtw8192xb_rfk_init(struct rtw89_dev *rtwdev)
 
 	rtw8192xb_rck(rtwdev);
 	rtw8192xb_dack(rtwdev, RTW89_CHANCTX_0);
+	rtw8192xb_rx_dck(rtwdev, RTW89_PHY_0);
 }
 
 static void rtw8192xb_rfk_channel(struct rtw89_dev *rtwdev,
 				  struct rtw89_vif_link *rtwvif_link)
 {
 	rtw8192xb_mcc_get_ch_info(rtwdev, rtwvif_link->phy_idx);
+	rtw8192xb_rx_dck(rtwdev, rtwvif_link->phy_idx);
 	rtw8192xb_dpk(rtwdev);
 }
 
--- a/drivers/net/wireless/realtek/rtw89/rtw8192xb_rfk.c
+++ b/drivers/net/wireless/realtek/rtw89/rtw8192xb_rfk.c
@@ -508,6 +508,105 @@ void rtw8192xb_dack(struct rtw89_dev *rtwdev, enum rtw89_chanctx_idx chanctx_idx
 	rtw89_btc_ntfy_wl_rfk(rtwdev, phy_map, BTC_WRFKT_DACK, BTC_WRFK_STOP);
 }
 
+static void _rx_dck_kip(struct rtw89_dev *rtwdev, enum rtw89_rf_path path,
+			u32 mode)
+{
+	u32 val;
+	int ret;
+
+	rtw89_phy_write32(rtwdev, 0x80ac, 0xfc000001 | mode);
+	rtw89_phy_write32(rtwdev, 0x80ac, 0x7c000001 | mode);
+	rtw89_phy_write32_mask(rtwdev, R_KIP_RPT1, B_KIP_RPT1_SEL, 0x34);
+
+	ret = read_poll_timeout_atomic(rtw89_phy_read32_mask, val, val,
+				       2, 3000, false, rtwdev, R_RPT_COM, BIT(16));
+	if (ret)
+		rtw89_debug(rtwdev, RTW89_DBG_RFK,
+			    "[RX_DCK] S%d mode 0x%x timeout\n", path, mode);
+}
+
+/* RX DC offset calibration run by the KIP with the ADC fed from the RXBB */
+static void _set_rx_dck(struct rtw89_dev *rtwdev, enum rtw89_rf_path path)
+{
+	u32 rxck = R_P0_RXCK + (path << 13);
+	u32 ofst = path << 8;
+	u32 bkup[7];
+
+	rtw89_write_rf(rtwdev, path, RR_DCK1, RR_DCK1_CLR, 0x8);
+
+	bkup[0] = rtw89_phy_read32(rtwdev, rxck);
+	bkup[1] = rtw89_phy_read32(rtwdev, R_PATH0_SAMPL_DLY_T_V1 + ofst);
+	bkup[2] = rtw89_phy_read32(rtwdev, R_PATH0_BW_SEL_V1 + ofst);
+	bkup[3] = rtw89_phy_read32(rtwdev, R_DRCK + ofst);
+	bkup[4] = rtw89_phy_read32(rtwdev, 0xc0e8 + ofst);
+	bkup[5] = rtw89_phy_read32(rtwdev, R_IQK_CFG);
+	bkup[6] = rtw89_phy_read32(rtwdev, R_KIP_RPT1);
+
+	rtw89_phy_write32_mask(rtwdev, R_P0_NRBW + (path << 13), B_P0_NRBW_DBG, 0x1);
+	_rxck_force(rtwdev, path, true, ADC_1920M);
+
+	rtw89_phy_write32_mask(rtwdev, R_ADDCK0_RL + ofst, B_ADDCK0_RLS, 0x3);
+	rtw89_phy_write32_mask(rtwdev, R_ADDCK0 + ofst, GENMASK(7, 6), 0x3);
+	rtw89_phy_write32_mask(rtwdev, R_ANAPAR, B_ANAPAR_CRXBB, 0x1);
+	rtw89_phy_write32_mask(rtwdev, R_ANAPAR_PW15, B_ANAPAR_PW15_H, 0xf);
+	rtw89_phy_write32_mask(rtwdev, R_ANAPAR_PW15, B_ANAPAR_PW15_H, 0x3);
+	rtw89_phy_write32_mask(rtwdev, R_ANAPAR, B_ANAPAR_ADCCLK, 0x0);
+	rtw89_phy_write32_mask(rtwdev, R_ANAPAR, B_ANAPAR_FLTRST, 0x0);
+	rtw89_phy_write32_mask(rtwdev, R_ANAPAR, B_ANAPAR_FLTRST, 0x1);
+
+	rtw89_phy_write32_mask(rtwdev, R_UPD_CLK, B_IQK_RFC_ON, 0x1);
+	rtw89_phy_write32_mask(rtwdev, R_NCTL_RPT, BIT(7), 0x1);
+	rtw89_phy_write32_mask(rtwdev, R_IQK_CFG, B_IQK_CFG_SET, 0x2);
+	rtw89_phy_write32_mask(rtwdev, R_KIP_RPT1, GENMASK(10, 8), 0x1);
+	rtw89_phy_write32_mask(rtwdev, 0x81e0, GENMASK(22, 20), 0x0);
+	rtw89_phy_write32_mask(rtwdev, 0x81e0, BIT(25), 0x0);
+	rtw89_phy_write32_mask(rtwdev, 0x82e0, GENMASK(22, 20), 0x1);
+	rtw89_phy_write32_mask(rtwdev, 0x82e0, BIT(25), 0x0);
+	rtw89_phy_write32_mask(rtwdev, R_NCTL_CFG, B_NCTL_CFG_SPAGE, path);
+
+	_rx_dck_kip(rtwdev, path, 0x30000); /* RX mode */
+	_rx_dck_kip(rtwdev, path, 0x50000); /* DPK mode */
+
+	rtw89_phy_write32(rtwdev, R_NCTL_RPT, 0x0);
+	rtw89_phy_write32_mask(rtwdev, R_P0_NRBW + (path << 13), B_P0_NRBW_DBG, 0x0);
+
+	rtw89_phy_write32(rtwdev, rxck, bkup[0]);
+	rtw89_phy_write32(rtwdev, R_PATH0_SAMPL_DLY_T_V1 + ofst, bkup[1]);
+	rtw89_phy_write32(rtwdev, R_PATH0_BW_SEL_V1 + ofst, bkup[2]);
+	rtw89_phy_write32(rtwdev, R_DRCK + ofst, bkup[3]);
+	rtw89_phy_write32(rtwdev, 0xc0e8 + ofst, bkup[4]);
+	rtw89_phy_write32(rtwdev, R_IQK_CFG, bkup[5]);
+	rtw89_phy_write32(rtwdev, R_KIP_RPT1, bkup[6]);
+	rtw89_phy_write32_mask(rtwdev, R_UPD_CLK, B_IQK_RFC_ON, 0x0);
+}
+
+void rtw8192xb_rx_dck(struct rtw89_dev *rtwdev, enum rtw89_phy_idx phy)
+{
+	u32 rf_reg5;
+	u8 path;
+
+	rtw89_phy_write32(rtwdev, R_NCTL_RW, 0x4);
+
+	for (path = RF_PATH_A; path < RF_PATH_NUM_8192XB; path++) {
+		rf_reg5 = rtw89_read_rf(rtwdev, path, RR_RSV1, RFREG_MASK);
+
+		if (rtwdev->is_tssi_mode[path])
+			rtw89_phy_write32_mask(rtwdev, R_P0_TSSI_TRK + (path << 13),
+					       B_P0_TSSI_TRK_EN, 0x1);
+
+		rtw89_write_rf(rtwdev, path, RR_RSV1, RR_RSV1_RST, 0x0);
+		rtw89_write_rf(rtwdev, path, RR_MOD, RR_MOD_MASK, RR_MOD_V_RX);
+		_set_rx_dck(rtwdev, path);
+		rtw89_write_rf(rtwdev, path, RR_RSV1, RFREG_MASK, rf_reg5);
+
+		if (rtwdev->is_tssi_mode[path])
+			rtw89_phy_write32_mask(rtwdev, R_P0_TSSI_TRK + (path << 13),
+					       B_P0_TSSI_TRK_EN, 0x0);
+	}
+
+	rtw89_phy_write32(rtwdev, R_NCTL_RW, 0x0);
+}
+
 /* The vendor driver skips DPK with an external PA and keeps the DPD off. */
 void rtw8192xb_dpk(struct rtw89_dev *rtwdev)
 {
--- a/drivers/net/wireless/realtek/rtw89/rtw8192xb_rfk.h
+++ b/drivers/net/wireless/realtek/rtw89/rtw8192xb_rfk.h
@@ -10,6 +10,7 @@
 void rtw8192xb_mcc_get_ch_info(struct rtw89_dev *rtwdev, enum rtw89_phy_idx phy);
 void rtw8192xb_rck(struct rtw89_dev *rtwdev);
 void rtw8192xb_dack(struct rtw89_dev *rtwdev, enum rtw89_chanctx_idx chanctx_idx);
+void rtw8192xb_rx_dck(struct rtw89_dev *rtwdev, enum rtw89_phy_idx phy);
 void rtw8192xb_dpk(struct rtw89_dev *rtwdev);
 void rtw8192xb_set_channel_rf(struct rtw89_dev *rtwdev,
 			      const struct rtw89_chan *chan,
